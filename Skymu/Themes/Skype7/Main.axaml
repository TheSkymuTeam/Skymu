<theming:MainWindowBase
    x:Class="Skymu.Skype7.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skymu.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
    xmlns:global="clr-namespace:Skymu"
    xmlns:local="clr-namespace:Skymu.Skype7"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preferences="clr-namespace:Skymu.Preferences"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:theming="clr-namespace:Skymu.Theming"
    xmlns:uc="clr-namespace:Skymu.UserControls"
    xmlns:yggdrasil="clr-namespace:Yggdrasil.Models;assembly=Yggdrasil"
    Title="Skymu"
    Width="1448"
    Height="856"
    MinWidth="600"
    MinHeight="450"
    Background="#F5FCFE"
    Closing="Main_Closing"
    FontFamily="Segoe UI"
    FontSize="12"
    RenderOptions.TextRenderingMode="SubpixelAntialias"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    CanResize="True"
    SystemDecorations="Full"
    mc:Ignorable="d">
    <Window.Resources>
        <ControlTheme x:Key="TextBlockViewerStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </ControlTheme>
        <ControlTheme x:Key="SkypeHint" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#646464" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Grid Margin="0,0,10,10" Background="Transparent">
                            <Border Background="#FFFFE1" BorderBrush="#646464" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="7" Opacity="0.55" Color="#202020"  OffsetX="0" OffsetY="2" />
                                </Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="ToolbarHit" TargetType="Path">
            <Setter Property="Fill" Value="#DCF4FD" />
            <Setter Property="Opacity" Value="0" />
        </ControlTheme>
        <ControlTheme x:Key="ChatAuthorStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#A2C5D3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
</ControlTheme>
<converters:ByteArrayToImageSourceConverter x:Key="AvatarConverter" />
        <converters:MsgByteArrayToImageConverter x:Key="MsgByteArrayToImageConverter" />
        <converters:SenderToColorConverter x:Key="SenderToColorConverter" />
        <converters:NullDependentVisibilityConverter x:Key="NullDependentVisibilityConverter" />
        <converters:NullDependentMarginConverter x:Key="NullDependentMarginConverter" />
        <converters:NullDependentBoolean x:Key="NullDependentBoolean" />
        <converters:StatusToTextConverter x:Key="StatIntToText" />
        <converters:ForwardedMessageStatusConverter x:Key="ForwardedMessageStatusConverter" />
        <converters:HalfValueConverter x:Key="HalfValueConverter" />
        <converters:ReplyBodyConverter x:Key="ReplyBodyConverter" />
        <converters:ConnectionStatusConverter x:Key="ConnectionStatusConverter" />
        <converters:ChannelTypeConverter x:Key="ChannelTypeConverter" />
        <converters:TextStatusConverter x:Key="TextStatusConverter" />
        <converters:MsgIDMultiToVisibilityConverter x:Key="IDToVisibilityConverter" />
        <local:IsSelfConverter x:Key="IsSelfConverter" />
        <SolidColorBrush x:Key="Skype7SelectionBrush" Color="#C7EDFC" />
        <converters:BoolToBrushConverter x:Key="SelectedToSelectionBrush"
            TrueBrush="{StaticResource Skype7SelectionBrush}"
            FalseBrush="{x:Null}" />
        <converters:BoolToWhiteForegroundConverter x:Key="SelectedToContactUsername"
            TrueBrush="#1A1A1A"
            FalseBrush="#2B2B30" />
        <converters:BoolToWhiteForegroundConverter x:Key="SelectedToContactStatus"
            TrueBrush="#5B6770"
            FalseBrush="#6E6E73" />
        <converters:BoolToWhiteForegroundConverter x:Key="SelectedToWhite"
            TrueBrush="White"
            FalseBrushResourceKey="Text.VeryHighContrast" />
        <converters:BoolToDoubleConverter x:Key="SelfAvatarColumnWidth" TrueValue="108" FalseValue="72" />
        <converters:BoolToDoubleConverter x:Key="BoolToAngle" TrueValue="90" FalseValue="0" />
        <converters:CountGreaterThanZeroConverter x:Key="CountGreaterThanZeroConverter" />
        <converters:CompactRecentsNameForegroundConverter x:Key="CompactRecentsNameForegroundConverter" />
        <converters:CompactGroupNameForegroundConverter x:Key="CompactGroupNameForegroundConverter" />
        <converters:CompactRecentsFontWeightConverter x:Key="CompactRecentsFontWeightConverter" />
        <converters:ShowSenderAndNotSelfConverter x:Key="ShowSenderAndNotSelfConverter" />
        <converters:IdentifierToSelfAvatarWidthConverter x:Key="IdentifierToSelfAvatarWidthConverter" />
        <converters:NotSelfFromIdentifierConverter x:Key="NotSelfFromIdentifierConverter" />
        <converters:IdentifierToSelfBubbleBrushConverter x:Key="IdentifierToSelfBubbleBrushConverter" />
        <converters:IdentifierToSelfBubbleMarginConverter x:Key="IdentifierToSelfBubbleMarginConverter" />
        <converters:IsSelfFromIdentifierConverter x:Key="IsSelfFromIdentifierConverter" />
        <converters:SelfMessageBubbleBrushConverter x:Key="SelfMessageBubbleBrushConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BoolToThicknessConverter x:Key="SelfBubbleMarginConverter"
            TrueThickness="0"
            FalseThickness="0,0,32,0" />
        <converters:PreviewVisibilityConverter x:Key="PreviewVisibilityConverter" />
        <converters:CompactConversationTypeConverter x:Key="CompactConversationTypeConverter" />
        <converters:FormatFullTextConverter x:Key="FormatFullTextConverter" ViewerStyle="{StaticResource TextBlockViewerStyle}" />
        <converters:FormatFullActionMessageConverter x:Key="FormatFullActionMessageConverter" ViewerStyle="{StaticResource TextBlockViewerStyle}" />
        <ControlTheme x:Key="WindowButtonStyle" TargetType="global:SliceControl">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="-1,0,0,0" />
            <Setter Property="HoverTransition" Value="False" />
            <Setter Property="SliceMode" Value="0" />
            <Setter Property="ElementCount" Value="4" />
            <Setter Property="StackDirection" Value="Vertical" />
            <Setter Property="DefaultIndex" Value="0" />
            <Setter Property="HoverIndex" Value="2" />
            <Setter Property="PressedIndex" Value="3" />
        </ControlTheme>
        <ControlTheme x:Key="LongIconStyle" TargetType="Image">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Width" Value="36" />
        </ControlTheme>
        <!--  CONTACT ITEM TEMPLATE START  -->
        <!--  shared style for both targeted templates  -->
        <ControlTheme x:Key="ContactUsernameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="#2B2B30" />
        </ControlTheme>
        <ControlTheme x:Key="ContactStatusStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6E6E73" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </ControlTheme>
        <!--  COMPACT RECENTS TEMPLATES START  -->
        <DataTemplate x:Key="DateHeaderTemplate" DataType="{x:Type global:DateHeaderItem}">
            <Grid Height="40">
                <TextBlock
                    Margin="16,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="#6E6E73"
                    Text="{Binding DateText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactDirectMessageTemplate" DataType="{x:Type yggdrasil:DirectMessage}">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Margin="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.Clip>
                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                    </Grid.Clip>
                    <Ellipse Fill="#B9D7E4" />
                    <Image Stretch="UniformToFill" >
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                <Binding Path="Avatar" />
                                <Binding Source="user" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Grid>
                <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="-2,0,15,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="compactName"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource CompactRecentsNameForegroundConverter}">
                                    <Binding Path="UnreadCount" />
                                    <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                </MultiBinding>
                            </TextBlock.Foreground>
                            <TextBlock.FontWeight>
                                <MultiBinding Converter="{StaticResource CompactRecentsFontWeightConverter}">
                                    <Binding Path="UnreadCount" />
                                    <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                </MultiBinding>
                            </TextBlock.FontWeight>
                        </TextBlock>
                        <TextBlock
                            x:Name="compactUnread"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#FF8C00"
                            IsVisible="{Binding UnreadCount, Converter={StaticResource CountGreaterThanZeroConverter}}"
                            Text="{Binding UnreadCount}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="1,2,0,0"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        FontWeight="Normal"
                        Foreground="#6E6E73"
                        Text="{Binding Description}"
                        TextTrimming="CharacterEllipsis"
                        IsVisible="{Binding Description, Converter={StaticResource NullDependentVisibilityConverter}}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CompactGroupTemplate" DataType="{x:Type yggdrasil:Group}">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="40" Height="40" Margin="15,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.Clip>
                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                    </Grid.Clip>
                    <Ellipse Fill="#B9D7E4" />
                    <Image Stretch="UniformToFill" >
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                <Binding Path="Avatar" />
                                <Binding Source="group" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Grid>
                <TextBlock
                    x:Name="compactGroupName"
                    Grid.Column="1"
                    Margin="0,0,18,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Text="{Binding DisplayName}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{StaticResource CompactGroupNameForegroundConverter}">
                            <Binding Path="UnreadCount" />
                            <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                        </MultiBinding>
                    </TextBlock.Foreground>
                    <TextBlock.FontWeight>
                        <MultiBinding Converter="{StaticResource CompactRecentsFontWeightConverter}">
                            <Binding Path="UnreadCount" />
                            <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                        </MultiBinding>
                    </TextBlock.FontWeight>
                </TextBlock>
                <TextBlock
                    x:Name="compactGroupUnread"
                    Grid.Column="2"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="#FF8C00"
                    IsVisible="{Binding UnreadCount, Converter={StaticResource CountGreaterThanZeroConverter}}"
                    Text="{Binding UnreadCount}" />
            </Grid>
        </DataTemplate>
        <!--  COMPACT RECENTS TEMPLATES END  -->
    </Window.Resources>

    <Window.DataTemplates>
        <!--  User template  -->
        <DataTemplate DataType="{x:Type yggdrasil:DirectMessage}">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.Clip>
                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                    </Grid.Clip>
                    <Image Stretch="UniformToFill">
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                <Binding Path="Avatar" />
                                <Binding Source="user" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="usernameText"
                        Theme="{StaticResource ContactUsernameStyle}"
                        Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToContactUsername}}"
                        Text="{Binding DisplayName}" />
                    <TextBlock
                        x:Name="statusText"
                        Theme="{StaticResource ContactStatusStyle}"
                        Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToContactStatus}}"
                        Text="{Binding Partner.Status, TargetNullValue=''}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <!--  Group template  -->
        <DataTemplate DataType="{x:Type yggdrasil:Group}">
            <Grid Height="32" Margin="2,4,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2" />
                    <RowDefinition Height="14" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Profile picture  -->
                <Grid
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Margin="2,0,0,0">
                    <Border Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="2" Opacity="0.50" Color="{DynamicResource Avatar.Shadow}"  OffsetX="0" OffsetY="1" />
                        </Border.Effect>
                        <Grid>
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource AvatarConverter}">
                                        <Binding Path="Avatar" />
                                        <Binding Source="group" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <Border BorderBrush="{DynamicResource Avatar.Border}" BorderThickness="1" />
                        </Grid>
                    </Border>
                </Grid>
                <global:SliceControl
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="14"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    DefaultIndex="21"
                    ElementCount="22"
                    HoverIndex="-1"
                    PressedIndex="-1"
                    SliceMode="0"
                    Source="Assets/Universal/Icon/skype-status-small.png"
                    StackDirection="Horizontal" />
                <!--  Name + member count  -->
                <TextBlock
                    x:Name="usernameText"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Theme="{StaticResource ContactUsernameStyle}"
                    Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToContactUsername}}"
                    Text="{Binding DisplayName}" />
                <TextBlock
                    x:Name="statusText"
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,1,0,0"
                    Theme="{StaticResource ContactStatusStyle}"
                    Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToContactStatus}}"
                    Text="{Binding Members.Length, StringFormat={}{0} members}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type global:CategoryHeaderItem}">
            <Border
                Height="20"
                Margin="0"
                Padding="8,0"
                Background="{DynamicResource Sidebar.Header}">
                <TextBlock
                    Margin="2,0,0,1"
                    VerticalAlignment="Center"
                    FontFamily="Tahoma"
                    FontSize="11"
                    Foreground="{DynamicResource Text.VeryHighContrast}"
                    Text="{Binding CategoryName}" />
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type yggdrasil:ServerChannel}">
            <Grid Height="22" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <global:SliceControl
                    Grid.Column="0"
                    Width="14"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    DefaultIndex="{Binding ChannelType, Converter={StaticResource ChannelTypeConverter}}"
                    ElementCount="11"
                    HoverIndex="-1"
                    PressedIndex="-1"
                    SliceMode="0"
                    Source="Assets/Universal/Icon/skype-channel.png"
                    StackDirection="Horizontal" />
                <TextBlock
                    x:Name="channelText"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Theme="{StaticResource ContactStatusStyle}"
                    Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource SelectedToWhite}}"
                    Text="{Binding DisplayName}" />
            </Grid>
        </DataTemplate>
        <!--  Server template  -->
        <TreeDataTemplate DataType="{x:Type yggdrasil:Server}" ItemsSource="{Binding GroupedChannels}">
            <Grid Height="32" Margin="2,4,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2" />
                    <RowDefinition Height="14" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Profile picture  -->
                <Grid
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Margin="2,0,0,0">
                    <Border Background="Transparent">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="2"
                                OffsetX="0"
                                OffsetY="1"
                                Color="{DynamicResource Avatar.Shadow}" />
                        </Border.Effect>
                        <Grid>
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource AvatarConverter}">
                                        <Binding Path="Avatar" />
                                        <Binding Source="group" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <Border BorderBrush="{DynamicResource Avatar.Border}" BorderThickness="1" />
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock
                    x:Name="usernameText"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Theme="{StaticResource ContactUsernameStyle}"
                    Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource SelectedToContactUsername}}"
                    Text="{Binding DisplayName}" />
                <TextBlock
                    x:Name="statusText"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,1,0,0"
                    Theme="{StaticResource ContactStatusStyle}"
                    Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource SelectedToContactStatus}}"
                    Text="{Binding MemberCount, StringFormat={}{0} members}" />
                <ToggleButton
                    Grid.RowSpan="3"
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=TwoWay}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Width="12" Height="12">
                                <Image
                                    Width="12"
                                    Height="12"
                                    Source="Assets/Universal/Main/collapse-toggle-background.png" />
                                <Image
                                    x:Name="ToggleImage"
                                    Width="12"
                                    Height="12"
                                    RenderTransformOrigin="0.5,0.5"
                                    Source="Assets/Universal/Main/collapse-toggle-arrow.png">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToAngle}}" />
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </TreeDataTemplate>
        <!--  CONTACT ITEM TEMPLATE END  -->
        <DataTemplate DataType="{x:Type local:ChatDateItem}">
            <Grid Height="30" UseLayoutRounding="True" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Grid.Column="0"
                    Height="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Fill="#E4ECEF"
                    Opacity="0.55" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="#A2C5D3"
                    Tag="transcript"
                    Cursor="IBeam" UseLayoutRounding="True"
                    Text="{Binding Text}" />
                <Rectangle
                    Grid.Column="2"
                    Height="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Fill="#E4ECEF"
                    Opacity="0.55" />
            </Grid>
        </DataTemplate>
        <!--  CONVERSATION ITEM TEMPLATES START  -->
        <!--  MessageItem Template  -->
        <DataTemplate DataType="{x:Type yggdrasil:ActionMessage}">
            <Grid HorizontalAlignment="Stretch">
                <Grid
                    x:Name="ConversationGrid"
                    Margin="0,10,40,0"
                    HorizontalAlignment="Stretch">
                    <!--  148 + 428 + 50  -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <!--  Center area  -->
                    <!--  Reply header  -->
                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,20,2"
                        IsVisible="{Binding ParentMessage, Converter={StaticResource NullDependentVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center" Source="Assets/Themeable/Main/reply-arrow.png" />
                        <TextBlock
                            Grid.Column="1"
                            FontFamily="Tahoma"
                            FontSize="11"
                            Foreground="{DynamicResource Text.LowContrast}"
                            LineHeight="1"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Replying to {0} - &quot;{1}&quot;">
                                    <Binding Path="ParentMessage.Author.DisplayName" />
                                    <Binding Converter="{StaticResource ReplyBodyConverter}" Path="ParentMessage.Text" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                    <!--  Message body + attachment  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,20,0"
                        Orientation="Vertical">
                        <ContentControl Content="{Binding Converter={StaticResource FormatFullActionMessageConverter}}" IsVisible="{Binding Text, Converter={StaticResource NullDependentVisibilityConverter}}" />
                        <Image
                            MaxWidth="300"
                            MaxHeight="300"
                            Margin="{Binding Converter={StaticResource NullDependentMarginConverter}}"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            Source="{Binding Attachments, Converter={StaticResource MsgByteArrayToImageConverter}}"
                            Stretch="Uniform"
                            PointerReleased="OpenImage_Click"
                            IsVisible="{Binding Attachments, Converter={StaticResource NullDependentVisibilityConverter}}" />
                    </StackPanel>
                    <!--  Timestamp  -->
                    <Grid
                        Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <TextBlock
                            FontFamily="Tahoma"
                            FontSize="11"
                            Foreground="{DynamicResource Text.LowContrast}"
                            Text="{Binding Time, StringFormat=h:mm tt}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:MessageGroup}">
            <Border Margin="{Binding ChatContentMargin, RelativeSource={RelativeSource AncestorType=local:Main}}" Background="Transparent">
            <Grid
                x:Name="msgRoot"
                Margin="0,6,8,6"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsSelf, Converter={StaticResource SelfAvatarColumnWidth}}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="msgAvatar"
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Margin="18,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{StaticResource ShowSenderAndNotSelfConverter}">
                            <Binding Path="ShowSenderName" />
                            <Binding Path="IsSelf" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <Ellipse Fill="#B9D7E4" />
                    <Image Stretch="UniformToFill" >
                        <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                        </Image.Clip>
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                <Binding Path="Sender.Avatar" />
                                <Binding Source="user" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Grid>
                <TextBlock
                    x:Name="msgName"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    Theme="{StaticResource ChatAuthorStyle}"
                    Tag="transcript"
                    Cursor="IBeam"
                    Text="{Binding Sender.DisplayName}">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{StaticResource ShowSenderAndNotSelfConverter}">
                            <Binding Path="ShowSenderName" />
                            <Binding Path="IsSelf" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <Grid
                    x:Name="bubbleHost"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="bubble"
                        Margin="{Binding IsSelf, Converter={StaticResource SelfBubbleMarginConverter}}"
                        Padding="17,9,17,9"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{Binding IsSelf, Converter={StaticResource SelfMessageBubbleBrushConverter}}"
                        CornerRadius="4.5">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type yggdrasil:Message}">
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Tag="transcript"
                                        Cursor="IBeam"
                                        FontFamily="Segoe UI"
                                        FontSize="13"
                                        Foreground="#2B2B30"
                                        Text="{Binding Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Path
                        x:Name="tailIn"
                        Width="7"
                        Height="10"
                        Margin="-6,12,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Data="M 7,0 L 0,5 L 7,10 Z"
                        Fill="{Binding IsSelf, Converter={StaticResource SelfMessageBubbleBrushConverter}}"
                        Stretch="Fill"
                        IsVisible="{Binding IsSelf, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Path
                        x:Name="tailOut"
                        Width="7"
                        Height="10"
                        Margin="0,12,-6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Data="M 0,0 L 7,5 L 0,10 Z"
                        Fill="{Binding IsSelf, Converter={StaticResource SelfMessageBubbleBrushConverter}}"
                        Stretch="Fill"
                        IsVisible="{Binding IsSelf}" />
                </Grid>
                <TextBlock
                    x:Name="msgTime"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,12,14,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontFamily="Segoe UI"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#8FBFCF"
                    Tag="transcript"
                    Cursor="IBeam"
                    Text="{Binding Time, StringFormat=h:mm tt}" />
            </Grid>
            </Border>
        </DataTemplate>
        <!-- Single messages still use this if not grouped (e.g. images). -->
        <DataTemplate DataType="{x:Type yggdrasil:Message}">
            <Border Margin="{Binding ChatContentMargin, RelativeSource={RelativeSource AncestorType=local:Main}}" Background="Transparent">
            <Grid
                x:Name="msgRoot"
                Margin="0,6,8,6"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Author.Identifier, Converter={StaticResource IdentifierToSelfAvatarWidthConverter}}" />
                    <ColumnDefinition Width="*" MinWidth="0" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="msgAvatar"
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Margin="18,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Author.Identifier, Converter={StaticResource NotSelfFromIdentifierConverter}}">
                    <Ellipse Fill="#B9D7E4" />
                    <Image Stretch="UniformToFill" >
                        <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                        </Image.Clip>
                        <Image.Source>
                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                <Binding Path="Author.Avatar" />
                                <Binding Source="user" />
                            </MultiBinding>
                        </Image.Source>
                    </Image>
                </Grid>
                <TextBlock
                    x:Name="msgName"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,4"
                    Theme="{StaticResource ChatAuthorStyle}"
                    Tag="transcript"
                    Cursor="IBeam"
                    Text="{Binding Author.DisplayName}"
                    IsVisible="{Binding Author.Identifier, Converter={StaticResource NotSelfFromIdentifierConverter}}" />
                <Grid
                    x:Name="bubbleHost"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                    <Border
                        x:Name="bubble"
                        Margin="{Binding Author.Identifier, Converter={StaticResource IdentifierToSelfBubbleMarginConverter}}"
                        Padding="17,9,17,9"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="{Binding Author.Identifier, Converter={StaticResource IdentifierToSelfBubbleBrushConverter}}"
                        CornerRadius="4.5">
                        <StackPanel>
                            <TextBlock
                                Tag="transcript"
                                Cursor="IBeam"
                                FontFamily="Segoe UI"
                                FontSize="13"
                                Foreground="#2B2B30"
                                Text="{Binding Text, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsVisible="{Binding Text, Converter={StaticResource NullDependentVisibilityConverter}}" />
                            <Image
                                MaxWidth="280"
                                MaxHeight="220"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Source="{Binding Attachments, Converter={StaticResource MsgByteArrayToImageConverter}}"
                                Stretch="Uniform"
                                PointerReleased="OpenImage_Click"
                                IsVisible="{Binding Attachments, Converter={StaticResource NullDependentVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Path
                        x:Name="tailIn"
                        Width="7"
                        Height="10"
                        Margin="-6,12,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Data="M 7,0 L 0,5 L 7,10 Z"
                        Fill="{Binding Author.Identifier, Converter={StaticResource IdentifierToSelfBubbleBrushConverter}}"
                        Stretch="Fill"
                        IsVisible="{Binding Author.Identifier, Converter={StaticResource NotSelfFromIdentifierConverter}}" />
                    <Path
                        x:Name="tailOut"
                        Width="7"
                        Height="10"
                        Margin="0,12,-6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Data="M 0,0 L 7,5 L 0,10 Z"
                        Fill="{Binding Author.Identifier, Converter={StaticResource IdentifierToSelfBubbleBrushConverter}}"
                        Stretch="Fill"
                        IsVisible="{Binding Author.Identifier, Converter={StaticResource IsSelfFromIdentifierConverter}}" />
                </Grid>
                <TextBlock
                    x:Name="msgTime"
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,12,14,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontFamily="Segoe UI"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="#8FBFCF"
                    Tag="transcript"
                    Cursor="IBeam"
                    Text="{Binding Time, StringFormat=h:mm tt}" />
            </Grid>
            </Border>
        </DataTemplate>
        <!--  CallStartedItem Template  -->
        <DataTemplate DataType="{x:Type yggdrasil:CallStartedNotice}">
            <Grid Margin="0,9.5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="114" />
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="1"
                    FontFamily="Tahoma"
                    FontSize="11"
                    Foreground="{DynamicResource Text.LowContrast}"
                    Text="{Binding StartedBy, StringFormat='Call started by: {0}'}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="Tahoma"
                    FontSize="11"
                    Foreground="{DynamicResource Text.LowContrast}"
                    Text="{Binding Time, StringFormat=h:mm tt}" />
            </Grid>
        </DataTemplate>
        <!--  CallEndedItem Template  -->
        <DataTemplate DataType="{x:Type yggdrasil:CallEndedNotice}">
            <Grid Margin="0,9.5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="114" />
                    <ColumnDefinition Width="430" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="1"
                    FontFamily="Tahoma"
                    FontSize="11"
                    Foreground="{DynamicResource Text.LowContrast}"
                    Text="{Binding Duration, StringFormat='Call ended, duration: {0}'}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    FontFamily="Tahoma"
                    FontSize="11"
                    Foreground="{DynamicResource Text.LowContrast}"
                    Text="{Binding Time, StringFormat=h:mm tt}" />
            </Grid>
        </DataTemplate>
        <!--  CONVERSATION ITEM TEMPLATE END  -->
    </Window.DataTemplates>

    <Window.Resources>
        <ControlTheme x:Key="Skype7SidebarScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="10" Background="Transparent" >
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#BBD6E0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="Skype7PickerScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="3" />
            <Setter Property="MinWidth" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="3" Background="Transparent" >
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C0C0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="Skype7PickerScroll" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid >
                            <ScrollContentPresenter />
                            <ScrollBar
                                x:Name="PART_VerticalScrollBar"
                                Width="3"
                                Margin="0,0,3,0"
                                HorizontalAlignment="Right"
                                Cursor="Arrow"
                                Orientation="Vertical"
                                Theme="{StaticResource Skype7PickerScrollBar}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="Skype7SidebarList" TargetType="ListBox">
            <Setter Property="Background" Value="#F5FCFE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            Margin="0"
                            Padding="0"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid Background="#F5FCFE">
                                        <ScrollContentPresenter
                                            x:Name="PART_ContentPresenter"
                                            Margin="0,0,10,0" />
                                        <ScrollBar
                                            x:Name="PART_VerticalScrollBar"
                                            ZIndex="2"
                                            HorizontalAlignment="Right"
                                            Cursor="Arrow"
                                            Orientation="Vertical"
                                            Theme="{StaticResource Skype7SidebarScrollBar}" />
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="NoInsetListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer
                            x:Name="ScrollViewer"
                            Margin="0"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="Bottom"
                           
                            Focusable="false">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
    </Window.Resources>

    <Grid x:Name="WindowArea" PointerPressed="WindowArea_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="MenuBarArea" Grid.Row="0" Orientation="Vertical">
            <Menu
                x:Name="MainMenuBar"
                Height="20"
                Background="{DynamicResource Active.Menubar}"
                FontFamily="Segoe UI"
                FontSize="11">
                <MenuItem Header="{Binding [sMAINMENU_SKYPE], Source={StaticResource Lang}}">
                    <MenuItem x:Name="MenubarStatusHolder" Header="{Binding [sMAINMENU_SKYPE_ONLINESTATUS], Source={StaticResource Lang}}">
                        <MenuItem Click="OnStatus" Header="{Binding [sTRAYHINT_USER_ONLINE], Source={StaticResource Lang}}" />
                        <MenuItem Click="OnStatus" Header="{Binding [sTRAYHINT_USER_AWAY], Source={StaticResource Lang}}" />
                        <MenuItem Click="OnStatus" Header="{Binding [sTRAYHINT_USER_DND], Source={StaticResource Lang}}" />
                        <MenuItem Click="OnStatus" Header="{Binding [sTRAYHINT_USER_INVISIBLE], Source={StaticResource Lang}}" />
                        <MenuItem Header="{Binding [sTRAYHINT_USER_OFFLINE], Source={StaticResource Lang}}" IsEnabled="False" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Click="OnSignOut" Header="{Binding [sMAINMENU_SKYPE_SIGN_OUT], Source={StaticResource Lang}}" />
                    <MenuItem Click="OnSwitchUser" Header="{Binding [sMAINMENU_SKYPE_SWITCH_USER], Source={StaticResource Lang}}" />
                    <MenuItem Click="OnClose" Header="{Binding [sMAINMENU_SKYPE_CLOSE], Source={StaticResource Lang}}" />
                </MenuItem>
                <MenuItem Header="{Binding [sMAINMENU_CONTACTS], Source={StaticResource Lang}}">
                    <MenuItem Click="OnAddContact" Header="{Binding [sMAINMENU_CONTACTS_ADD_CONTACT], Source={StaticResource Lang}}" />
                </MenuItem>
                <MenuItem Header="{Binding [sMAINMENU_VIEW], Source={StaticResource Lang}}">
                    <MenuItem Click="OnContacts" Header="{Binding [sMAINMENU_VIEW_CONTACTS], Source={StaticResource Lang}}" />
                    <MenuItem Click="OnRecent" Header="{Binding [sMAINMENU_VIEW_CONVERSATIONS], Source={StaticResource Lang}}" />
                    <MenuItem Click="OnHome" Header="{Binding [sMAINMENU_VIEW_HOME], Source={StaticResource Lang}}" />
                </MenuItem>
                <MenuItem Header="{Binding [sMAINMENU_TOOLS], Source={StaticResource Lang}}">
                    <MenuItem Click="OnOptions" Header="{Binding [sMAINMENU_TOOLS_OPTIONS], Source={StaticResource Lang}}" />
                </MenuItem>
                <MenuItem Header="{Binding [sMAINMENU_HELP], Source={StaticResource Lang}}">
                    <MenuItem Click="OnAbout" Header="{Binding [sMAINMENU_HELP_ABOUT], Source={StaticResource Lang}}" />
                </MenuItem>
            </Menu>
            <Rectangle x:Name="MainMenuBarDivider" Height="1" Fill="{DynamicResource Active.Background}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Border Grid.RowSpan="2" Background="#F5FCFE">
                <Grid Background="#F5FCFE">
                    <ContentControl x:Name="FillWindowHost" Background="#F5FCFE" />
                        <Grid x:Name="ContentArea" Background="#F5FCFE">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"
                                MinWidth="172" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="Sidebar"
                            Grid.Column="0"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            Background="#F5FCFE">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  Sidebar top  -->
                            <StackPanel Grid.Row="0" Orientation="Vertical">
                                <!--  Username section  -->
                                <Border
                                    Grid.Row="0"
                                    BorderBrush="{DynamicResource Metro.Border}"
                                    BorderThickness="0">
                                    <Grid Height="70">
                                        <Image
                                            Width="130"
                                            Height="35"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False"
                                            Source="Assets/Classic/user-holder.png"
                                            Stretch="None" />
                                        <Grid Width="40" Height="40" Margin="15,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Ellipse Fill="#B9D7E4" />
                                            <Image
                                                x:Name="SelfAvatar"
                                                Stretch="UniformToFill" >
                                                <Image.Clip>
                                                    <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                            <Border
                                                Width="215"
                                                Height="25"
                                                Margin="60,22,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                PointerEntered="Wash_Enter"
                                                PointerExited="Wash_Leave">
                                                <Grid>
                                                    <Border
                                                        x:Name="NameWash"
                                                        Height="19"
                                                        VerticalAlignment="Center"
                                                        Background="#DCF4FD"
                                                        CornerRadius="9.5"
                                                        IsHitTestVisible="False"
                                                        Opacity="0" />
                                                    <TextBlock
                                                        x:Name="StatusBox"
                                                        Margin="8,0,8,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Segoe UI"
                                                        FontSize="13"
                                                        FontWeight="Normal"
                                                        Foreground="#2B2B30"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        <StackPanel
                                            x:Name="StatusArea"
                                            Margin="42,51,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="True"
                                            ToolTip.Tip="Change your status"
                                            PointerReleased="StatusArea_Click"
                                            Orientation="Horizontal">
                                            <StackPanel.Resources>
                                                <ContextMenu x:Key="StatusMenu">
                                                    <MenuItem
                                                        x:Name="sm_online"
                                                        Click="StatusMenuItemClick"
                                                        Header="{Binding [sSTATUSMENU_CAPTION_ONLINE], Source={StaticResource Lang}}">
                                                        <MenuItem.Icon>
                                                            <global:SliceControl
                                                                Width="14"
                                                                DefaultIndex="2"
                                                                ElementCount="22"
                                                                HoverIndex="-1"
                                                                PressedIndex="-1"
                                                                SliceMode="0"
                                                                Source="Assets/Universal/Icon/skype-status-small.png"
                                                                StackDirection="Horizontal" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        x:Name="sm_away"
                                                        Click="StatusMenuItemClick"
                                                        Header="{Binding [sSTATUSMENU_CAPTION_AWAY], Source={StaticResource Lang}}">
                                                        <MenuItem.Icon>
                                                            <global:SliceControl
                                                                Width="14"
                                                                DefaultIndex="3"
                                                                ElementCount="22"
                                                                HoverIndex="-1"
                                                                PressedIndex="-1"
                                                                SliceMode="0"
                                                                Source="Assets/Universal/Icon/skype-status-small.png"
                                                                StackDirection="Horizontal" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        x:Name="sm_dnd"
                                                        Click="StatusMenuItemClick"
                                                        Header="{Binding [sSTATUSMENU_CAPTION_DND], Source={StaticResource Lang}}">
                                                        <MenuItem.Icon>
                                                            <global:SliceControl
                                                                Width="14"
                                                                DefaultIndex="5"
                                                                ElementCount="22"
                                                                HoverIndex="-1"
                                                                PressedIndex="-1"
                                                                SliceMode="0"
                                                                Source="Assets/Universal/Icon/skype-status-small.png"
                                                                StackDirection="Horizontal" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        x:Name="sm_invisible"
                                                        Click="StatusMenuItemClick"
                                                        Header="{Binding [sSTATUSMENU_CAPTION_INVISIBLE], Source={StaticResource Lang}}">
                                                        <MenuItem.Icon>
                                                            <global:SliceControl
                                                                Width="14"
                                                                DefaultIndex="14"
                                                                ElementCount="22"
                                                                HoverIndex="-1"
                                                                PressedIndex="-1"
                                                                SliceMode="0"
                                                                Source="Assets/Universal/Icon/skype-status-small.png"
                                                                StackDirection="Horizontal" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        x:Name="sm_offline"
                                                        Click="StatusMenuItemClick"
                                                        Header="{Binding [sSTATUSMENU_CAPTION_OFFLINE], Source={StaticResource Lang}}"
                                                        IsEnabled="False">
                                                        <MenuItem.Icon>
                                                            <global:SliceControl
                                                                Width="14"
                                                                DefaultIndex="14"
                                                                ElementCount="22"
                                                                HoverIndex="-1"
                                                                PressedIndex="-1"
                                                                SliceMode="0"
                                                                Source="Assets/Universal/Icon/skype-status-small.png"
                                                                StackDirection="Horizontal" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem
                                                        x:Name="sm_call_forwarding"
                                                        Click="StatusMenuItemClick"
                                                        Header="{Binding [sSTATUSMENU_CAPTION_CF_OPTIONS2], Source={StaticResource Lang}}">
                                                        <MenuItem.Icon>
                                                            <global:SliceControl
                                                                Width="14"
                                                                DefaultIndex="13"
                                                                ElementCount="22"
                                                                HoverIndex="-1"
                                                                PressedIndex="-1"
                                                                SliceMode="0"
                                                                Source="Assets/Universal/Icon/skype-status-small.png"
                                                                StackDirection="Horizontal" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </StackPanel.Resources>
                                            <Grid
                                                Width="14"
                                                Height="14"
                                                Background="Transparent"
                                                PointerEntered="StatusArea_MouseEnter"
                                                PointerExited="StatusArea_MouseLeave">
                                                <Image
                                                    x:Name="StatusGlyph"
                                                    Width="14"
                                                    Height="14"
                                                    IsHitTestVisible="False"
                                                    Source="Assets/Classic/icon-presence.png"
                                                    Stretch="None" />
                                                <Path
                                                    x:Name="StatusArrow"
                                                    Width="8"
                                                    Height="5"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False"
                                                    Stroke="White"
                                                    StrokeThickness="1.4"
                                                   
                                                   
                                                   
                                                    Data="M0.5,0.5 L4,3.6 L7.5,0.5"
                                                    IsVisible="False" />
                                                <global:SliceControl
                                                    x:Name="StatusIcon"
                                                    Width="1"
                                                    Height="1"
                                                    Opacity="0"
                                                    HorizontalAlignment="Left"
                                                    DefaultIndex="0"
                                                    ElementCount="22"
                                                    HoverIndex="-1"
                                                    PressedIndex="-1"
                                                    SliceMode="0"
                                                    Source="Assets/Universal/Icon/skype-status.png"
                                                    StackDirection="Horizontal" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!--  Search, then Home / Call / New, matching Skype 7.18  -->
                                <Border
                                    Height="41"
                                    Margin="0,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0">
                                    <Grid>
                                        <Rectangle
                                            x:Name="SearchLine"
                                            Height="1"
                                            Margin="15,0,15,0"
                                            VerticalAlignment="Bottom"
                                            Fill="#D3E6EA"
                                            IsHitTestVisible="False" />
                                        <Image
                                            Width="12"
                                            Height="12"
                                            Margin="17,1,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Source="Assets/Classic/icon-search.png"
                                            Stretch="None" />
                                        <global:SliceControl
                                            x:Name="PseudoSearchBox"
                                            Width="0"
                                            Height="0"
                                            IsVisible="False"
                                            DefaultIndex="0"
                                            ElementCount="2"
                                            Interactive="False"
                                            PressedIndex="1"
                                            Source="Assets/Themeable/Main/search-box.png"
                                            StackDirection="Vertical" />
                                        <TextBox
                                            x:Name="SearchBox"
                                            Height="17"
                                            Margin="40,11,16,0"
                                            Padding="0,0,4,0"
                                            VerticalAlignment="Top"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontFamily="Segoe UI"
                                            FontSize="13"
                                            GotFocus="SearchBox_Focused"
                                            LostFocus="SearchBox_Unfocused" />
                                    </Grid>
                                </Border>

                                <Grid Height="30" Margin="8,5,0,0" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="73" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="82">
                                        <Path Theme="{StaticResource ToolbarHit}" ToolTip.Tip="See updates from your contacts in Skype Home." Data="M15,0 H67 A15,15 0 0 1 67,30 H15 A15,15 0 0 1 15,0 Z" PointerEntered="Pill_Enter" PointerExited="Pill_Leave" PointerReleased="HomeButton_Click" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Segoe UI" FontSize="13" Foreground="#2B2B30" Text="Home" />
                                        <Image Width="14" Height="13" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Source="Assets/Classic/icon-home.png" Stretch="None" />
                                        <global:SliceControl x:Name="HomeButton" Width="0" Height="0" IsVisible="False" />
                                    </Grid>
                                    <Grid Grid.Column="2" Width="68">
                                        <Path Theme="{StaticResource ToolbarHit}" ToolTip.Tip="Call mobiles and landlines from the dial pad." Data="M15,0 H53 A15,15 0 0 1 53,30 H15 A15,15 0 0 1 15,0 Z" PointerEntered="Pill_Enter" PointerExited="Pill_Leave" PointerReleased="CallPhones_Click" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Segoe UI" FontSize="13" Foreground="#2B2B30" Text="Call" />
                                        <Image Width="8" Height="11" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Source="Assets/Classic/icon-call.png" Stretch="None" />
                                    </Grid>
                                    <Grid Grid.Column="4" Width="73">
                                        <Path Theme="{StaticResource ToolbarHit}" ToolTip.Tip="Create a new conversation that anyone can join." Data="M15,0 H58 A15,15 0 0 1 58,30 H15 A15,15 0 0 1 15,0 Z" PointerEntered="Pill_Enter" PointerExited="Pill_Leave" PointerReleased="AddContact_Click" />
                                        <TextBlock Margin="27,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="Segoe UI" FontSize="13" Foreground="#2B2B30" Text="New" />
                                        <Image Width="16" Height="16" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Source="Assets/Classic/icon-new.png" Stretch="None" />
                                        <global:SliceControl x:Name="AddContactButton" Width="0" Height="0" IsVisible="False" />
                                    </Grid>
                                </Grid>
                                <!--  Sidebar tabs  -->
                                <Border BorderBrush="#D3E6EA" BorderThickness="0,0,0,1" Height="40" Margin="0,10,0,0">
                                    <Grid x:Name="SidebarTabs">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="0" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <global:SliceControl
                                                x:Name="btnContacts"
                                                Cursor="Hand"
                                                Width="65"
                                                Height="17"
                                                Margin="15,6,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                Background="Transparent"
                                                BackgroundHover="Transparent"
                                                BackgroundPressed="Transparent"
                                               
                                                HoverIndex="-1"
                                                IsRadioButton="True"
                                                LeftWidth="25"
                                                PointerEntered="SidebarTab_Hover"
                                                PointerExited="SidebarTab_Leave"
                                                PointerReleased="SidebarTab_BtnDown"
                                                PressedIndex="2"
                                                RightWidth="2"
                                                Source="Assets/Themeable/Main/empty.png"
                                                StackDirection="Vertical"
                                                Text=""
                                                Themeable="False" />
                                            <TextBlock
                                                x:Name="TabContactsLabel"
                                                Margin="15,6,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                FontFamily="Segoe UI"
                                                FontSize="13"
                                                FontWeight="Normal"
                                                Foreground="#2B2B30"
                                                IsHitTestVisible="False"
                                                Text="CONTACTS" />
                                            <Grid
                                                x:Name="TabContactsMark"
                                                Width="28"
                                                Height="9"
                                                Margin="34,0,0,-1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                IsHitTestVisible="False"
                                                IsVisible="False">
                                                <Path Fill="#F5FCFE" Data="M0,9 L0,8 C8,8 10,0 14,0 C18,0 20,8 28,8 L28,9 Z" />
                                                <Path Stroke="#D3E6EA" StrokeThickness="1" Data="M0,8 C8,8 10,0 14,0 C18,0 20,8 28,8" />
                                            </Grid>
                                        </Grid>
                                        <global:SliceControl
                                            x:Name="btnServers"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            DefaultIndex="0"
                                            ElementCount="5"
                                           
                                            HoverIndex="-1"
                                            IsRadioButton="True"
                                            LeftWidth="25"
                                            PointerReleased="SidebarTab_BtnDown"
                                            PressedIndex="2"
                                            RightWidth="2"
                                            Source="Assets/Themeable/Main/servers.png"
                                            StackDirection="Vertical"
                                            Text="Servers"
                                            TextColor="{DynamicResource Text.HighContrast}"
                                            TextFont="Arial"
                                            TextLeftMargin="29"
                                            TextSize="13"
                                            TextWeight="Normal"
                                            Themeable="True" />
                                        <Grid Grid.Column="2">
                                            <global:SliceControl
                                                x:Name="btnRecents"
                                                Width="47"
                                                Height="17"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                Background="Transparent"
                                                BackgroundHover="Transparent"
                                                BackgroundPressed="Transparent"
                                               
                                                HoverIndex="-1"
                                                IsRadioButton="True"
                                                LeftWidth="25"
                                                PointerEntered="SidebarTab_Hover"
                                                PointerExited="SidebarTab_Leave"
                                                PointerReleased="SidebarTab_BtnDown"
                                                PressedIndex="2"
                                                RightWidth="2"
                                                Source="Assets/Themeable/Main/empty.png"
                                                StackDirection="Vertical"
                                                Text=""
                                                Themeable="False" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False">
                                                <TextBlock
                                                    x:Name="TabRecentsLabel"
                                                    FontFamily="Segoe UI"
                                                    FontSize="13"
                                                    FontWeight="Normal"
                                                    Foreground="#0095CC"
                                                    Text="RECENT" />
                                                <TextBlock
                                                    x:Name="RecentBadge"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe UI"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#FF8C00"
                                                    Text="" />
                                            </StackPanel>
                                            <Grid
                                                x:Name="TabRecentsMark"
                                                Width="28"
                                                Height="9"
                                                Margin="11,0,0,-1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                IsHitTestVisible="False">
                                                <Path Fill="#F5FCFE" Data="M0,9 L0,8 C8,8 10,0 14,0 C18,0 20,8 28,8 L28,9 Z" />
                                                <Path Stroke="#D3E6EA" StrokeThickness="1" Data="M0,8 C8,8 10,0 14,0 C18,0 20,8 28,8" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="3"
                                            Height="15"
                                            Margin="45,8,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Cursor="Hand"
                                            ToolTip.Tip="Show unread conversations"
                                            Orientation="Horizontal"
                                            PointerReleased="FilterAll_Click">
                                            <TextBlock
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                FontWeight="Normal"
                                                Foreground="#6E6E73"
                                                Text="All" />
                                            <Image
                                                Width="8"
                                                Height="5"
                                                Margin="6,1,0,0"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False"
                                                Source="Assets/Classic/icon-chevron-down.png"
                                                Stretch="None" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!--  Sidebar bottom  -->
                            <Border
                                Grid.Row="1"
                                Background="#F5FCFE"
                                BorderThickness="0">
                                <Grid Background="#F5FCFE">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="0" />
                                    </Grid.RowDefinitions>
                                    <!--  Contacts/recents/servers list  -->
                                    <Grid x:Name="ContactsArea" Grid.Row="0" Background="#F5FCFE">
                                        <ListBox
                                            x:Name="ConversationList"
                                            BorderThickness="0"
                                            PointerReleased="ConversationList_ItemClicked"
                                            Theme="{StaticResource Skype7SidebarList}"
                                            mc:Ignorable="d">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VirtualizingStackPanel />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Focusable" Value="True" />
                                                    <Setter Property="IsEnabled" Value="True" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemBorder"
                                                                    Background="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SelectedToSelectionBrush}}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                                                                </Style>
                                            </ListBox.Styles>
                                        </ListBox>
                                        <TreeView
                                            x:Name="ServersList"
                                            Grid.Row="1"
                                            Background="White"
                                            BorderThickness="0"
                                            PointerReleased="ServerListItem_Clicked"
                                            IsVisible="False">
                                            <TreeView.Styles>
                                                <Style Selector="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="False" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TreeViewItem">
                                                                <StackPanel>
                                                                    <Border x:Name="ItemBorder"
                                                                        Background="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SelectedToSelectionBrush}}">
                                                                        <ContentPresenter x:Name="PART_Header" Content="{Binding $self.Header}" />
                                                                    </Border>
                                                                    <ItemsPresenter x:Name="ItemsHost"
                                                                        IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                                                </StackPanel>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TreeView.Styles>
                                        </TreeView>
                                        <!--  Add contact  -->
                                        <Grid x:Name="AddContactGrid" IsVisible="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="3*" />
                                                    <RowDefinition Height="1*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel
                                                    x:Name="AddContactInfoPanel"
                                                    Grid.Row="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                    <Image
                                                        Width="80"
                                                        Height="80"
                                                        Source="Assets/Universal/Main/add-contact-bg.png" />
                                                    <uc:QuickLTB
                                                        Key="sADD_CONTACT_PANEL_MESSAGE"
                                                        x:Name="AddContactHint"
                                                        Margin="25,15,25,0"
                                                        FontFamily="Tahoma"
                                                        FontSize="11"
                                                        Foreground="#333333"
                                                        TextBlock.TextAlignment="Center" />
                                                    <TextBlock HorizontalAlignment="Center" Text="WARNING: NOT IMPLEMENTED" />
                                                </StackPanel>
                                            </Grid>

                                            <ListBox
                                                x:Name="AddUserList"
                                                BorderThickness="0"
                                                Theme="{StaticResource NoInsetListBox}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Focusable" Value="True" />
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="ItemBorder"
                                                                        Background="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SelectedToSelectionBrush}}">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                                                                    </Style>
                                            </ListBox.Styles>
                                            </ListBox>
                                            <global:SliceControl
                                                x:Name="btnAddContactClose"
                                                Width="20"
                                                Height="20"
                                                Margin="0,2,2,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                DefaultIndex="1"
                                                ElementCount="5"
                                                HoverIndex="1"
                                                PointerReleased="AddContact_Close"
                                                PressedIndex="2"
                                                SliceMode="0"
                                                Source="Assets/Universal/Main/add-contact-close.png"
                                                StackDirection="Vertical" />
                                        </Grid>
                                    </Grid>
                                    <!--  User count  -->
                                    <Border
                                        Grid.Row="1"
                                        Height="0"
                                        IsVisible="False"
                                        Background="{DynamicResource Metro.Sidebar.UserCountTab}"
                                        BorderBrush="{DynamicResource Metro.Border}"
                                        BorderThickness="0">
                                        <TextBlock x:Name="GlobalUserCount" IsVisible="False" Text="" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ContentControl
                            x:Name="SelectedItemHolder"
                            Grid.Row="0"
                            IsVisible="False" />
                        <Border
                            x:Name="SkypeSplitter"
                            Grid.Column="1"
                            Background="#D3E6EA"
                            BorderBrush="#D3E6EA"
                            BorderThickness="0"
                            Cursor="SizeWestEast"
                            PointerPressed="SkypeSplitter_Press"
                            PointerMoved="SkypeSplitter_PointerMoved" />
                        <Grid
                            x:Name="ChatArea"
                            Grid.Column="2"
                            Margin="0"
                            DataContext="{Binding SelectedItem, ElementName=ConversationList}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0"
                                    MinHeight="0"
                                    MaxHeight="0" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="White" BorderBrush="#E4ECEF" BorderThickness="0,0,0,1">
                                <StackPanel>
                                <Grid x:Name="ConversationHeader" Height="80" Margin="10,0,20,0" PointerReleased="Header_RightClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image
                                        x:Name="CPAProfilePic"
                                        Grid.Column="0"
                                        Width="60"
                                        Height="60"
                                        Cursor="Hand"
                                        PointerReleased="HeaderAvatar_Click"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Stretch="UniformToFill">
                                        <Image.Clip>
                                            <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30" />
                                        </Image.Clip>
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                <Binding Path="Avatar" />
                                                <Binding Source="user" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,16,0,0">
                                        <Grid Height="32">
                                            <Image
                                                x:Name="HeaderStar"
                                                Width="14"
                                                Height="13"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                ToolTip.Tip="Add to favorites"
                                                Source="Assets/Classic/icon-star.png"
                                                Stretch="None" />
                                            <Border
                                                Margin="15,0,0,0"
                                                Padding="8,2,8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                PointerEntered="TitleWash_Enter"
                                                PointerExited="TitleWash_Leave">
                                                <Grid>
                                                    <Border
                                                        x:Name="TitleWashFill"
                                                        Background="#DFE1E2"
                                                        CornerRadius="4"
                                                        IsHitTestVisible="False"
                                                        Opacity="0" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock
                                                            x:Name="Topbar"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe UI Light"
                                                            FontSize="22"
                                                            FontWeight="Normal"
                                                            Foreground="#2B2B30"
                                                            Text="{Binding DisplayName}" />
                                                        <Image
                                                            x:Name="TitleEdit"
                                                            Width="16"
                                                            Height="16"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Opacity="0"
                                                            Source="Assets/Classic/icon-topic-pencil.png"
                                                            Stretch="None"
                                                            IsVisible="False" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <StackPanel Height="16" Margin="0,2,0,0" Orientation="Horizontal" Cursor="Hand" PointerReleased="Participants_Click">
                                            <Image
                                                Width="5"
                                                Height="8"
                                                Margin="0,1,18,0"
                                                VerticalAlignment="Top"
                                                Source="Assets/Classic/icon-chevron-right.png"
                                                Stretch="None" />
                                            <TextBlock
                                                x:Name="HeaderSubtitle"
                                                VerticalAlignment="Top"
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                FontWeight="Normal"
                                                Foreground="#6E6E73"
                                                Text="" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="40" Height="40" Margin="0,0,15,0" ToolTip.Tip="Video call" PointerEntered="StripHover_Enter" PointerExited="StripHover_Leave" Tag="{Binding ElementName=VideoHoverLayer}">
                                            <global:SliceControl
                                                x:Name="VideoCallButton"
                                                Width="40"
                                                Height="40"
                                                Background="Transparent"
                                                Command="{Binding DataContext.VideoCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                HoverIndex="-1"
                                                PressedIndex="-1"
                                                SliceMode="0"
                                                Source="Assets/Classic/btn-video-strip.png"
                                                StackDirection="Vertical"
                                                Text="" />
                                            <Grid x:Name="VideoHoverLayer" Width="40" Height="40" IsHitTestVisible="False" Opacity="0">
                                                <global:SliceControl
                                                    Width="40"
                                                    Height="40"
                                                    IsHitTestVisible="False"
                                                    DefaultIndex="1"
                                                    ElementCount="5"
                                                    HoverIndex="-1"
                                                    PressedIndex="-1"
                                                    SliceMode="0"
                                                    Source="Assets/Classic/btn-video-strip.png"
                                                    StackDirection="Vertical"
                                                    Text="" />
                                            </Grid>
                                        </Grid>
                                        <Grid Width="40" Height="40" Margin="0,0,15,0" ToolTip.Tip="Call group" PointerEntered="StripHover_Enter" PointerExited="StripHover_Leave" Tag="{Binding ElementName=VoiceHoverLayer}">
                                            <global:SliceControl
                                                x:Name="CallButton"
                                                Width="40"
                                                Height="40"
                                                Background="Transparent"
                                                DefaultIndex="0"
                                                ElementCount="5"
                                                HoverIndex="-1"
                                                PointerReleased="CallButtonClick"
                                                PressedIndex="-1"
                                                SliceMode="0"
                                                Source="Assets/Classic/btn-voice-strip.png"
                                                StackDirection="Vertical"
                                                Text="" />
                                            <Grid x:Name="VoiceHoverLayer" Width="40" Height="40" IsHitTestVisible="False" Opacity="0">
                                                <global:SliceControl
                                                    Width="40"
                                                    Height="40"
                                                    IsHitTestVisible="False"
                                                    DefaultIndex="1"
                                                    ElementCount="5"
                                                    HoverIndex="-1"
                                                    PressedIndex="-1"
                                                    SliceMode="0"
                                                    Source="Assets/Classic/btn-voice-strip.png"
                                                    StackDirection="Vertical"
                                                    Text="" />
                                            </Grid>
                                        </Grid>
                                        <Grid Width="40" Height="40" ToolTip.Tip="Add people" PointerEntered="StripHover_Enter" PointerExited="StripHover_Leave" Tag="{Binding ElementName=AddHoverLayer}">
                                            <Image Width="40" Height="40" IsHitTestVisible="False" Source="Assets/Classic/btn-add.png" Stretch="None" />
                                            <Grid x:Name="AddHoverLayer" Width="40" Height="40" IsHitTestVisible="False" Opacity="0">
                                                <global:SliceControl
                                                    Width="40"
                                                    Height="40"
                                                    IsHitTestVisible="False"
                                                    DefaultIndex="1"
                                                    ElementCount="5"
                                                    HoverIndex="-1"
                                                    PressedIndex="-1"
                                                    SliceMode="0"
                                                    Source="Assets/Classic/btn-add-strip.png"
                                                    StackDirection="Vertical"
                                                    Text="" />
                                            </Grid>
                                            <Border Width="40" Height="40" Background="Transparent" PointerReleased="FilterAll_Click" />
                                        </Grid>
                                        <global:SliceControl
                                            x:Name="CallDropdown"
                                            Width="0"
                                            Height="0"
                                            Opacity="0"
                                            DefaultIndex="0"
                                            ElementCount="5"
                                           
                                            HoverIndex="1"
                                            PressedIndex="2"
                                            Source="Assets/Universal/Main/btn_call_right.png"
                                            StackDirection="Vertical"
                                            Text="" />
                                    </StackPanel>
                                </Grid>
                                <Border
                                    x:Name="ParticipantStrip"
                                    Height="0"
                                    ClipToBounds="True"
                                    Background="White"
                                    IsVisible="False">
                                    <ItemsControl
                                        x:Name="ParticipantList"
                                        Margin="12,7,12,0"
                                        VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    Padding="6,0,8,0"
                                                    Background="#CCEFFC"
                                                    CornerRadius="9">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="10"
                                                            Height="10"
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            Fill="White" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe UI"
                                                            FontSize="12"
                                                            Foreground="#2B2B7B"
                                                            Text="{Binding DisplayName}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <ContentControl
                                    x:Name="browserHost"
                                    Grid.Row="1"
                                    IsVisible="False" />
                                <ContentControl
                                    x:Name="HomeUnavailableFrame"
                                    Grid.Row="1"
                                    IsVisible="False" />
                                <ContentControl x:Name="FillMessagePanelHost" IsVisible="False" />
                                <ContentControl x:Name="ChatProfileArea" Content="{Binding DataContext, ElementName=ChatArea}">
                                    <ContentControl.DataTemplates>
                                        <DataTemplate DataType="{x:Type yggdrasil:DirectMessage}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  Profile picture column  -->
                                                <Image
                                                    x:Name="CPAProfilePic"
                                                    Grid.Column="0"
                                                    Margin="4,4,5,9"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                            <Binding Path="Avatar" />
                                                            <Binding Source="user" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                    <Image.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="4" Color="{DynamicResource Avatar.Shadow}"  OffsetX="0" OffsetY="1" />
                                                    </Image.Effect>
                                                </Image>
                                                <!--  Information column  -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,12"
                                                    Orientation="Vertical">
                                                    <!--  Text status row ("I'm bored", etc)  -->
                                                    <StackPanel
                                                        Margin="0,0,0,15"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal"
                                                        IsVisible="{Binding Partner.Status, Converter={StaticResource NullDependentVisibilityConverter}}">
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            Source="Assets/Universal/Main/mood.png" />
                                                        <TextBlock
                                                            Margin="9,0,0,0"
                                                            FontFamily="Tahoma"
                                                            FontSize="11"
                                                            Text="{Binding Partner.Status, TargetNullValue=''}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!--  Time row for remote user. TODO: implement this in Yggdrasil  -->
                                                    <StackPanel
                                                        x:Name="TimeRow"
                                                        Margin="0,0,0,15"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal"
                                                        IsVisible="False">
                                                        <Image
                                                            Width="16"
                                                            Height="16"
                                                            Source="Assets/Universal/Main/clock.png" />
                                                        <TextBlock
                                                            Margin="9,0,0,0"
                                                            FontFamily="Tahoma"
                                                            FontSize="11"
                                                            Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:h:mm tt}}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!--  Connection status row (online, offline, away, dnd)  -->
                                                    <StackPanel
                                                        x:Name="StatusRow"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                        <global:SliceControl
                                                            Width="14"
                                                            Height="14"
                                                            DefaultIndex="{Binding Partner.ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
                                                            ElementCount="22"
                                                            Interactive="False"
                                                            SliceMode="0"
                                                            Source="Assets/Universal/Icon/skype-status-small.png"
                                                            StackDirection="Horizontal" />
                                                        <TextBlock
                                                            Margin="11,0,0,0"
                                                            FontFamily="Tahoma"
                                                            FontSize="11"
                                                            Text="{Binding Partner.ConnectionStatus, Converter={StaticResource StatIntToText}}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type yggdrasil:Group}">
                                            <ItemsControl ItemsSource="{Binding Members}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type yggdrasil:User}">
                                                        <StackPanel
                                                            Width="120"
                                                            Margin="10,0"
                                                            Orientation="Vertical">
                                                            <!--  Name row with status icon  -->
                                                            <StackPanel
                                                                Margin="0,0,0,2"
                                                                HorizontalAlignment="Center"
                                                                Orientation="Horizontal">
                                                                <global:SliceControl
                                                                    Width="16"
                                                                    Height="16"
                                                                    VerticalAlignment="Center"
                                                                    DefaultIndex="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
                                                                    ElementCount="22"
                                                                    Interactive="False"
                                                                    SliceMode="0"
                                                                    Source="Assets/Universal/Icon/skype-status.png"
                                                                    StackDirection="Horizontal" />
                                                                <TextBlock
                                                                    MaxWidth="100"
                                                                    Margin="5,0,0,1"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="Tahoma"
                                                                    FontSize="11"
                                                                    Text="{Binding DisplayName}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                            <!--  Profile picture  -->
                                                            <Image
                                                                Width="85"
                                                                Margin="0,3,0,0"
                                                                Stretch="UniformToFill">
                                                                <Image.Source>
                                                                    <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                                        <Binding Path="Avatar" />
                                                                        <Binding Source="user" />
                                                                    </MultiBinding>
                                                                </Image.Source>
                                                                <Image.Effect>
                                                                    <DropShadowEffect
                                                                        BlurRadius="4" Color="{DynamicResource Avatar.Shadow}"  OffsetX="0" OffsetY="1" />
                                                                </Image.Effect>
                                                            </Image>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type yggdrasil:Server}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  Profile picture column  -->
                                                <Image
                                                    x:Name="CPAProfilePic"
                                                    Grid.Column="0"
                                                    Margin="4,4,5,9"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                            <Binding Path="Avatar" />
                                                            <Binding Source="group" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                    <Image.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="4" Color="{DynamicResource Avatar.Shadow}"  OffsetX="0" OffsetY="1" />
                                                    </Image.Effect>
                                                </Image>
                                                <!--  Information column  -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,12"
                                                    Orientation="Vertical">
                                                    <!--  Server channel count row  -->
                                                    <StackPanel
                                                        x:Name="StatusRow"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                        <global:SliceControl
                                                            Width="14"
                                                            Height="14"
                                                            DefaultIndex="2"
                                                            ElementCount="11"
                                                            Interactive="False"
                                                            SliceMode="0"
                                                            Source="Assets/Universal/Icon/skype-channel.png"
                                                            StackDirection="Horizontal" />
                                                        <TextBlock
                                                            Margin="11,0,0,0"
                                                            FontFamily="Tahoma"
                                                            FontSize="11"
                                                            Text="{Binding Channels.Count, StringFormat='{}Server - {0} channels'}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type yggdrasil:ServerChannel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--  Profile picture column  -->
                                                <Image
                                                    x:Name="CPAProfilePic"
                                                    Grid.Column="0"
                                                    Margin="4,4,5,9"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Stretch="UniformToFill">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource AvatarConverter}">
                                                            <Binding Path="Avatar" />
                                                            <Binding Source="group" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                    <Image.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="4" Color="{DynamicResource Avatar.Shadow}"  OffsetX="0" OffsetY="1" />
                                                    </Image.Effect>
                                                </Image>
                                                <!--  Information column  -->
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,12"
                                                    Orientation="Vertical">
                                                    <!--  Server channel descriptor row  -->
                                                    <StackPanel
                                                        x:Name="StatusRow"
                                                        HorizontalAlignment="Left"
                                                        Orientation="Horizontal">
                                                        <global:SliceControl
                                                            Width="14"
                                                            Height="14"
                                                            DefaultIndex="{Binding ChannelType, Converter={StaticResource ChannelTypeConverter}}"
                                                            ElementCount="11"
                                                            Interactive="False"
                                                            SliceMode="0"
                                                            Source="Assets/Universal/Icon/skype-channel.png"
                                                            StackDirection="Horizontal" />
                                                        <TextBlock
                                                            Margin="11,0,0,0"
                                                            FontFamily="Tahoma"
                                                            FontSize="11"
                                                            Text="Server channel"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </Grid>

                            <Rectangle
                                x:Name="ChatTopBarSplitter"
                                Grid.Row="2"
                                Cursor="SizeNorthSouth"
                                Fill="Transparent"
                                PointerPressed="ChatTopBarSplitter_Press"
                                PointerMoved="ChatTopBarSplitter_PointerMoved" />
                            <Border
                                x:Name="MessageWindow"
                                Grid.Row="3"
                                Margin="0"
                                Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="181*" />
                                        <RowDefinition Height="367*" />
                                        <RowDefinition Height="0" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Grid.Row="0"
                                        Height="0"
                                        IsVisible="False"
                                        Orientation="Horizontal">
                                        <global:SliceControl
                                            Width="37"
                                            Margin="10,0,0,0"
                                            DefaultIndex="0"
                                            ElementCount="5"
                                            HoverIndex="1"
                                            PointerReleased="AddButtonClick"
                                            PressedIndex="2"
                                            SliceMode="0"
                                            Source="Assets/Themeable/Main/add.png"
                                            StackDirection="Vertical"
                                            Themeable="True" />
                                        <global:SliceControl
                                            x:Name="WifiButton"
                                            Width="44"
                                            Margin="10,0,0,0"
                                            Command="{Binding DataContext.RunSpeedTestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            DefaultIndex="0"
                                            ElementCount="5"
                                            HoverIndex="1"
                                            PressedIndex="2"
                                            SliceMode="0"
                                            Source="Assets/Themeable/Main/network-none.png"
                                            StackDirection="Vertical"
                                            Themeable="True" />
                                    </StackPanel>
                                    <Image
                                        x:Name="Spinner"
                                        Grid.Row="3"
                                        Width="90"
                                        Height="90"
                                        Margin="523,48.333,523,229"
                                        RenderTransformOrigin="0.5,0.5"
                                        Source="Assets/Universal/Animations/spinner.png"
                                        IsVisible="False" />
                                    <Border
                                        x:Name="StickyDateBar"
                                        Grid.Row="2"
                                        ZIndex="2"
                                        Height="30"
                                        Margin="0,0,17,0"
                                        VerticalAlignment="Top"
                                        UseLayoutRounding="True" Background="#F0FFFFFF"
                                        IsHitTestVisible="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="TranscriptDate"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI"
                                                FontSize="12"
                                                FontWeight="Normal"
                                                Foreground="#A2C5D3" UseLayoutRounding="True"
                                                Text="" />
                                        </Grid>
                                    </Border>
                                    <ListBox
                                        x:Name="ConversationItemsList"
                                        Grid.Row="2"
                                        Grid.RowSpan="2"
                                        Margin="0,0,0,0"
                                        Padding="0,0,0,33"
                                        VerticalAlignment="Bottom"
                                        BorderThickness="0"
                                        Loaded="ConversationItemsList_Loaded"
                                        PointerReleased="Chat_RightClick"
                                        Theme="{StaticResource NoInsetListBox}"


                                        mc:Ignorable="d">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ItemBorder" Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                                                            </Style>
                                            </ListBox.Styles>
                                    </ListBox>
                                    <Grid
                                        Grid.Row="5"
                                        Margin="0"
                                        VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            HorizontalAlignment="Stretch"
                                            Orientation="Vertical">
                                            <StackPanel
                                                x:Name="TypingIndicator"
                                                Margin="0,0,0,7"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                IsVisible="False">
                                                <global:SliceControl
                                                    x:Name="TypingIndicatorIcon"
                                                    Width="23"
                                                    AnimationFps="30"
                                                    DefaultIndex="0"
                                                    ElementCount="37"
                                                    HoverIndex="-1"
                                                    IsAnimation="True"
                                                    PressedIndex="-1"
                                                    SliceMode="0"
                                                    Source="Assets/Universal/Main/pencil-write.png"
                                                    StackDirection="Vertical" />
                                                <TextBlock
                                                    x:Name="TypingIndicatorText"
                                                    Margin="3,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Text.MediumContrast}" />
                                            </StackPanel>
                                            <Border
                                                x:Name="MessageBoxPanel"
                                                Grid.ColumnSpan="3"
                                                Height="73"
                                                HorizontalAlignment="Stretch"
                                                Background="White"
                                                BorderThickness="0">
                                                <Grid>
                                                    <Border
                                                        x:Name="ComposerGripTop"
                                                        ZIndex="8"
                                                        Height="5"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        Cursor="SizeNorthSouth"
                                                        PointerPressed="ComposerEdge_Down"
                                                        PointerMoved="ComposerEdge_Move"
                                                        PointerReleased="ComposerEdge_Up"
                                                        Tag="top" />
                                                    <Border
                                                        x:Name="ComposerGripLeft"
                                                        ZIndex="8"
                                                        Width="6"
                                                        Margin="17,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        Cursor="SizeWestEast"
                                                        PointerPressed="ComposerEdge_Down"
                                                        PointerMoved="ComposerEdge_Move"
                                                        PointerReleased="ComposerEdge_Up"
                                                        Tag="left" />
                                                    <Border
                                                        x:Name="ComposerGripRight"
                                                        ZIndex="8"
                                                        Width="6"
                                                        Margin="0,0,17,0"
                                                        HorizontalAlignment="Right"
                                                        Background="Transparent"
                                                        Cursor="SizeWestEast"
                                                        PointerPressed="ComposerEdge_Down"
                                                        PointerMoved="ComposerEdge_Move"
                                                        PointerReleased="ComposerEdge_Up"
                                                        Tag="right" />
                                                    <StackPanel
                                                        x:Name="ComposerVia"
                                                        Margin="18,1,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Switch to SMS"
                                                        Orientation="Horizontal"
                                                        PointerReleased="FilterAll_Click">
                                                        <TextBlock
                                                            FontFamily="Segoe UI"
                                                            FontSize="11"
                                                            FontWeight="Normal"
                                                            Foreground="#2B2B30"
                                                            Text="via " />
                                                        <TextBlock
                                                            FontFamily="Segoe UI"
                                                            FontSize="11"
                                                            FontWeight="Normal"
                                                            Foreground="#0095CC"
                                                            Text="Skype" />
                                                        <Image
                                                            Width="7"
                                                            Height="4"
                                                            Margin="3,1,0,0"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Source="Assets/Classic/icon-chevron-via.png"
                                                            Stretch="None" />
                                                    </StackPanel>
                                                    <Border
                                                        x:Name="ComposerLine"
                                                        Height="1"
                                                        Margin="17,20,17,0"
                                                        VerticalAlignment="Top"
                                                        Background="#66CFF6" />
                                                    <TextBox
                                                        x:Name="MessageTextBox"
                                                        Margin="12,38,140,8"
                                                        Padding="0,0,0,0"
                                                        VerticalAlignment="Stretch"
                                                        AcceptsReturn="True"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontFamily="Segoe UI"
                                                        FontSize="13"
                                                        GotFocus="MessageTextBox_Focused"
                                                        LostFocus="MessageTextBox_Unfocused"
                                                        TextChanged="MessageTextBox_TextChanged"
                                                        TextWrapping="Wrap"
                                                        UseLayoutRounding="True"
                                                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                                    <Grid
                                                        x:Name="ComposerActions"
                                                        Height="32"
                                                        Margin="0,0,57,11"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="34" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0" Width="32" Height="32" PointerEntered="StripHover_Enter" PointerExited="StripHover_Leave" Tag="{Binding ElementName=ClipHoverLayer}">
                                                            <Image Width="32" Height="32" IsHitTestVisible="False" Source="Assets/Classic/icon-clip.png" Stretch="None" />
                                                            <Grid x:Name="ClipHoverLayer" Width="32" Height="32" IsHitTestVisible="False" Opacity="0">
                                                                <global:SliceControl
                                                                    Width="32"
                                                                    Height="32"
                                                                    IsHitTestVisible="False"
                                                                    DefaultIndex="1"
                                                                    ElementCount="5"
                                                                    HoverIndex="-1"
                                                                    PressedIndex="-1"
                                                                    SliceMode="0"
                                                                    Source="Assets/Classic/clip-strip.png"
                                                                    StackDirection="Vertical" />
                                                            </Grid>
                                                            <global:SliceControl
                                                                Width="32"
                                                                Height="32"
                                                                Background="Transparent"
                                                                Opacity="0"
                                                                PointerReleased="FilterAll_Click" />
                                                        </Grid>
                                                        <Grid Grid.Column="1" Width="32" Height="32" ToolTip.Tip="Insert emoticon or Moji" PointerEntered="StripHover_Enter" PointerExited="StripHover_Leave" Tag="{Binding ElementName=EmojiHoverLayer}">
                                                            <Image Width="32" Height="32" IsHitTestVisible="False" Source="Assets/Classic/icon-emoji.png" Stretch="None" />
                                                            <Grid x:Name="EmojiHoverLayer" Width="32" Height="32" IsHitTestVisible="False" Opacity="0">
                                                                <global:SliceControl
                                                                    x:Name="EmojiButton"
                                                                    Width="32"
                                                                    Height="32"
                                                                    IsHitTestVisible="False"
                                                                    DefaultIndex="1"
                                                                    ElementCount="5"
                                                                    HoverIndex="-1"
                                                                    PressedIndex="-1"
                                                                    SliceMode="0"
                                                                    Source="Assets/Classic/emoji-strip.png"
                                                                    StackDirection="Vertical" />
                                                            </Grid>
                                                            <Border Width="32" Height="32" Background="Transparent" PointerReleased="EmojiButton_Click" />
                                                        </Grid>
                                                    </Grid>
                                                    <Popup
                                                        x:Name="EmojiFlyout"
                                                       
                                                        HorizontalOffset="-226"
                                                        Placement="Top"
                                                        PlacementTarget="{Binding ElementName=EmojiButton}"
                                                        IsLightDismissEnabled="True"
                                                        VerticalOffset="0">
                                                        <Grid Width="269" Height="514">
                                                            <Border Width="269" Height="506" VerticalAlignment="Top" Background="White" BorderBrush="#8AA8B7" BorderThickness="1">
                                                                <DockPanel>
                                                                    <Border Height="42" DockPanel.Dock="Bottom" BorderBrush="#F2F2F2" BorderThickness="0,1,0,0" Background="White">
                                                                        <StackPanel Margin="17,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Border x:Name="EmojiTabRecent" Width="20" Height="20" Background="Transparent" Cursor="Hand" PointerReleased="EmojiTabRecent_Click">
                                                                                <Image Width="20" Height="20" Source="Assets/Classic/picker-recent.png" Stretch="None" />
                                                                            </Border>
                                                                            <Border x:Name="EmojiTabAll" Width="20" Height="20" Margin="22,0,0,0" Background="Transparent" Cursor="Hand" PointerReleased="EmojiTabAll_Click">
                                                                                <Image Width="20" Height="20" Source="Assets/Classic/picker-smile.png" Stretch="None" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ScrollViewer x:Name="EmojiGridScroll" Height="190" DockPanel.Dock="Bottom" Theme="{StaticResource Skype7PickerScroll}">
                                                                        <WrapPanel x:Name="EmojiWrapPanel" Width="243" Margin="10,6,0,0" HorizontalAlignment="Left" Orientation="Horizontal" />
                                                                    </ScrollViewer>
                                                                    <Border Height="1" DockPanel.Dock="Bottom" Background="#F2F2F2" />
                                                                    <Grid Height="28" DockPanel.Dock="Bottom">
                                                                        <TextBlock x:Name="EmojiPreviewName" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Foreground="#2B2B30" />
                                                                        <TextBlock x:Name="EmojiPreviewCode" Margin="0,0,16,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Foreground="#8A9BA3" />
                                                                    </Grid>
                                                                    <TextBlock x:Name="EmojiRecentEmpty" Margin="18,8,18,0" VerticalAlignment="Top" IsVisible="False" FontFamily="Segoe UI" FontSize="13" Foreground="#8A9BA3" Text="No recent emoticons" TextWrapping="Wrap" />
                                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <ContentControl x:Name="EmojiPreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </DockPanel>
                                                            </Border>
                                                            <Path Width="16" Height="8" Margin="0,0,19,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="White" Stroke="#8AA8B7" StrokeThickness="1" Data="M0,0 L8,8 L16,0" />
                                                        </Grid>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                        <Image
                                            x:Name="SendIcon"
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,17,11"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            IsHitTestVisible="False"
                                            Opacity="0.45"
                                            Source="Assets/Classic/icon-send.png"
                                            Stretch="None" />
                                        <Image
                                            x:Name="SendHoverIcon"
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,17,11"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            IsHitTestVisible="False"
                                            Opacity="0"
                                            Stretch="None" />
                                        <global:SliceControl
                                            x:Name="SendMsgButton"
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,17,11"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Opacity="0"
                                            Background="Transparent"
                                            DefaultIndex="1"
                                            ElementCount="5"
                                           
                                            Focusable="False"
                                            HoverIndex="2"
                                            ToolTip.Tip="Send"
                                            PointerEntered="SendHover_Enter"
                                            PointerExited="SendHover_Leave"
                                            PointerReleased="OnMsgSendClickButton"
                                            PressedIndex="3"
                                            Source="Assets/Classic/send-strip.png"
                                            StackDirection="Vertical"
                                            Text="" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</theming:MainWindowBase>

