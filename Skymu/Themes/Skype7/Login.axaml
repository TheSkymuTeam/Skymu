<Window
    x:Class="Skymu.Skype7.Login"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:converters="clr-namespace:Skymu.Converters"
    Title="Skype"
    DataContext="{StaticResource Lang}"
    Loaded="Login_Loaded"
    WindowStartupLocation="CenterScreen"
    CanResize="False"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:TextBoxHintVisibilityConverter x:Key="TextBoxHintVisibilityConverter" />
    </Window.Resources>
    <StackPanel Orientation="Vertical">
        <!--  selector strip  -->
        <Grid
            x:Name="SelectorStrip"
            Grid.Row="0"
            Height="30"
            Background="{DynamicResource Accent}">
            <StackPanel
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="ProtocolText"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Historic"
                    FontSize="12"
                    Foreground="White"
                    Text="Messaging service" />
                <ComboBox
                    x:Name="ProtocolComboBox"
                    Width="180"
                    FontFamily="Segoe UI Historic"
                    FontSize="12"
                    SelectionChanged="ProtocolSelectionChanged" />
            </StackPanel>
        </Grid>
        <Grid
            x:Name="MainGrid"
            Background="{DynamicResource Metro.Background}"
            Focusable="True"
            KeyDown="Grid_KeyDown">
            <Border
                Grid.ColumnSpan="2"
                Width="720"
                Height="472"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource Metro.Text.VeryHighContrast}"
                BorderThickness="0">
                <Grid>
                    <Image
                        x:Name="N1"
                        Width="138.5"
                        Height="61.5"
                        Margin="0,36,0,0"
                        VerticalAlignment="Top"
                        Source="avares://Skymu/Themes/Skype7/Assets/Universal/Branding/logo-about.png">
                        <Image.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Image.RenderTransform>
                    </Image>
                    <Image
                        x:Name="Spinner"
                        Width="128"
                        Height="128"
                        Margin="0,0,0,48"
                        RenderTransformOrigin="0.50785,0.5001"
                        Source="Assets/Universal/Animations/spinner.png"
                        IsVisible="False" />
                    <Grid x:Name="ControlsGrid">
                        <Label
                            x:Name="Header"
                            Margin="0,97,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="{x:Null}"
                            Content="{Binding [sZAPBUTTON_SIGNIN]}"
                            FontFamily="Segoe UI Light"
                            FontSize="34"
                            Foreground="{DynamicResource Metro.Text.VeryHighContrast}"
                            Opacity="1">
                            <Label.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Label.RenderTransform>
                        </Label>
                        <Label
                            x:Name="SubHeader"
                            Margin="0,143,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="{x:Null}"
                            Content="with your account"
                            FontFamily="Segoe UI Semilight"
                            FontSize="16"
                            Foreground="{DynamicResource Metro.Text.VeryHighContrast}"
                            Opacity="1">
                            <Label.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Label.RenderTransform>
                        </Label>

                        <Grid
                            x:Name="N4"
                            Width="280"
                            Height="32"
                            Margin="0,-55,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="1">
                            <Rectangle
                                Height="0.5"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource Accent}" />
                            <TextBox
                                x:Name="UsernameBox"
                                Padding="-2,0,0,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="{DynamicResource Metro.Text.VeryHighContrast}" />
                            <TextBlock
                                x:Name="UsernameHint"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource Text.MediumContrast}"
                                IsHitTestVisible="False"
                                Text="{Binding [sF_USERENTRY_LABEL_USERNAME]}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource TextBoxHintVisibilityConverter}">
                                        <Binding Path="Text.Length" ElementName="UsernameBox" />
                                        <Binding Path="IsFocused" ElementName="UsernameBox" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                        </Grid>

                        <Grid
                            x:Name="N5"
                            Width="280"
                            Height="32"
                            Margin="0,30,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="1">
                            <Rectangle
                                Height="0.5"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource Accent}" />
                            <TextBox
                                x:Name="PasswordTokenBox"
                                Padding="-2,0,0,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                PasswordChar="●"
                                Foreground="{DynamicResource Metro.Text.VeryHighContrast}" />
                            <TextBlock
                                x:Name="PasswordHint"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource Metro.Text.MediumContrast}"
                                IsHitTestVisible="False"
                                Text="{Binding [sF_USERENTRY_LABEL_PASSWORD]}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{StaticResource TextBoxHintVisibilityConverter}">
                                        <Binding Path="Text.Length" ElementName="PasswordTokenBox" />
                                        <Binding Path="IsFocused" ElementName="PasswordTokenBox" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                        </Grid>

                        <Border
                            x:Name="LoginButton"
                            Width="125"
                            Height="41"
                            Margin="0,292,0,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Metro.Text.Highlight}"
                            CornerRadius="21,21,21,21"
                            Cursor="Hand"
                            PointerReleased="LoginButton_Click"
                            Opacity="1">
                            <TextBlock
                                x:Name="LoginButtonLabel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Cursor="Hand"
                                FontFamily="Segoe UI Historic"
                                FontSize="14"
                                Foreground="White"
                                Text="{Binding [sZAPBUTTON_SIGNIN]}" />

                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid x:Name="N7" Opacity="1">
                            <HyperlinkButton
                                Margin="303,360,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="Create an account"
                                FontFamily="Segoe UI Historic"
                                FontSize="14"
                                Foreground="{DynamicResource Metro.Text.Highlight}"
                                Click="Hyperlink_Click" />
                            <HyperlinkButton
                                Margin="14,0,0,10"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="Trouble signing in?"
                                FontFamily="Segoe UI Historic"
                                FontSize="13"
                                Foreground="{DynamicResource Metro.Text.Highlight}"
                                Click="FooterLink_Click" />

                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</Window>
