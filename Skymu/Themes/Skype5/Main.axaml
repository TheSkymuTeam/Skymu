<theming:MainWindowBase
x:Class="Skymu.Skype5.Main"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:converters="clr-namespace:Skymu.Converters"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:global="clr-namespace:Skymu"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:sys="clr-namespace:System;assembly=mscorlib"
xmlns:theming="clr-namespace:Skymu.Theming"
xmlns:controls="clr-namespace:Skymu.Controls"
xmlns:yggdrasil="clr-namespace:Yggdrasil.Models;assembly=Yggdrasil"
Title="Skymu"
Width="1448"
Height="856"
MinWidth="584"
MinHeight="450"


Background="{DynamicResource Active.Background}"
Closing="Main_Closing"



Foreground="{DynamicResource Text.VeryHighContrast}"
CanResize="True"

WindowStartupLocation="CenterScreen"
SystemDecorations="None"
mc:Ignorable="d">
	<Window.Styles>
		<Style Selector="global|SliceControl.windowButton">
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="Height" Value="18" />
			<Setter Property="Margin" Value="-1,0,0,0" />
			<Setter Property="HoverTransition" Value="True" />			<Setter Property="SliceMode" Value="0" />
			<Setter Property="ElementCount" Value="4" />
			<Setter Property="StackDirection" Value="Vertical" />
			<Setter Property="DefaultIndex" Value="0" />
			<Setter Property="HoverIndex" Value="1" />
			<Setter Property="PressedIndex" Value="2" />
		</Style>
<Style Selector="global|SliceControl.addButtonHover">
    <Setter Property="TextColor" Value="{DynamicResource Text.HighContrast}" />
</Style>
<Style Selector="global|SliceControl.addButtonHover:pointerover">
    <Setter Property="TextColor" Value="#0099ff" />
</Style>
	</Window.Styles>
	<Window.Resources>
		<ControlTheme x:Key="NoInsetListBox" TargetType="ListBox">
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBox">
						<ScrollViewer
						x:Name="ScrollViewer"
						Margin="0"
						Padding="0"
						VerticalContentAlignment="Bottom"
						Background="{DynamicResource Card.Background}"
						
						Focusable="false">
							<ItemsPresenter Name="PART_ItemsPresenter"
                ItemsPanel="{TemplateBinding ItemsPanel}" />
						</ScrollViewer>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</ControlTheme>
		<ControlTheme x:Key="TextBlockViewerStyle" TargetType="TextBlock">
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Top" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontFamily" Value="Tahoma" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
			<Setter Property="Focusable" Value="True" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</ControlTheme>
		<ControlTheme x:Key="TitlebarTextStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="0,0,0,0" />
			<Setter Property="IsVisible" Value="False" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Panel.ZIndex" Value="2" />
			<Setter Property="FontFamily" Value="Arial" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Text" Value="{Binding WindowTitle, RelativeSource={RelativeSource AncestorType=Window}}" />
		</ControlTheme>
		<ControlTheme
		x:Key="TitlebarTextStyleAero"
		BasedOn="{StaticResource TitlebarTextStyle}"
		TargetType="TextBlock">
			<Setter Property="Margin" Value="0,4,0,0" />
			<Setter Property="IsVisible" Value="True" />
			<Setter Property="FontFamily" Value="Segoe UI" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="Normal" />
		</ControlTheme>
		<ControlTheme x:Key="LongIconStyle" TargetType="Image">
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Center" />			<Setter Property="Height" Value="16" />
			<Setter Property="Width" Value="36" />
		</ControlTheme>

		<!--  CONTACT ITEM TEMPLATE START  -->
		<!--  shared style for both targeted templates  -->
		<ControlTheme x:Key="ContactUsernameStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontFamily" Value="Tahoma" />
			<Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</ControlTheme>
		<ControlTheme x:Key="ContactStatusStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontFamily" Value="Tahoma" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource Text.LowContrast}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</ControlTheme>
		<ImageBrush x:Key="SBrush"
    Source="Assets/Themeable/Main/selection-background.png"
    Stretch="Fill" />
<converters:BoolToBrushConverter x:Key="SelectedToSelectionBrush"
    TrueBrush="{StaticResource SBrush}"
    FalseBrush="{x:Null}" />
		<converters:BoolToDoubleConverter x:Key="BoolToAngle" TrueValue="90" FalseValue="0" />
		<converters:ByteArrayToImageSourceConverter x:Key="AvatarConverter" />
		<converters:MsgByteArrayToImageConverter x:Key="MsgByteArrayToImageConverter" />
		<converters:SenderToColorConverter x:Key="SenderToColorConverter" />
		<converters:NullDependentVisibilityConverter x:Key="NullDependentVisibilityConverter" />
		<converters:NullDependentMarginConverter x:Key="NullDependentMarginConverter" />
		<converters:NullDependentBoolean x:Key="NullDependentBoolean" />
		<converters:StatusToTextConverter x:Key="StatIntToText" />
		<converters:IsCurrentUserToVisibilityConverter x:Key="IsCurrentUserToVisibilityConverter" />
		<converters:ForwardedMessageStatusConverter x:Key="ForwardedMessageStatusConverter" />
		<converters:HalfValueConverter x:Key="HalfValueConverter" />
		<converters:ReplyBodyConverter x:Key="ReplyBodyConverter" />
		<converters:ConnectionStatusConverter x:Key="ConnectionStatusConverter" />
		<converters:ChannelTypeConverter x:Key="ChannelTypeConverter" />
		<converters:TextStatusConverter x:Key="TextStatusConverter" />
		<converters:MsgIDMultiToVisibilityConverter x:Key="IDToVisibilityConverter" />
		<converters:PreviewVisibilityConverter x:Key="PreviewVisibilityConverter" />
		<converters:CompactConversationTypeConverter x:Key="CompactConversationTypeConverter" />
		<converters:FormatFullTextConverter x:Key="FormatFullTextConverter" ViewerStyle="{StaticResource TextBlockViewerStyle}" />
		<converters:FormatFullActionMessageConverter x:Key="FormatFullActionMessageConverter" ViewerStyle="{StaticResource TextBlockViewerStyle}" />
		<converters:BoolToWhiteForegroundConverter x:Key="SelectedToWhite"
    TrueBrush="White"
    FalseBrushResourceKey="Text.VeryHighContrast" />
<converters:BoolToWhiteForegroundConverter x:Key="SelectedToWhiteFromLow"
    TrueBrush="White"
    FalseBrushResourceKey="Text.LowContrast" />


		<!--  COMPACT RECENTS TEMPLATES START  -->
		<DataTemplate x:Key="DateHeaderTemplate" DataType="{x:Type global:DateHeaderItem}">
			<Border
			Height="20"
			Margin="0"
			Padding="8,0"
			Background="{DynamicResource Sidebar.Header}">
				<TextBlock
				Margin="2,0,0,1"
				VerticalAlignment="Center"
				
				
				Foreground="{DynamicResource Text.VeryHighContrast}"
				Text="{Binding DateText}" />
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="CompactDirectMessageTemplate" DataType="{x:Type yggdrasil:DirectMessage}">
			<Grid Height="22" Margin="8,1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="18" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<global:SliceControl
				Grid.Column="0"
				Width="14"
				Height="14"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				DefaultIndex="{Binding Partner.ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
				ElementCount="22"
				HoverIndex="-1"
				PressedIndex="-1"
				SliceMode="0"
				Source="Assets/Universal/Icon/skype-status-small.png"
				StackDirection="Horizontal" />
				<TextBlock
				x:Name="compactName"
				Grid.Column="1"
				Margin="6,0,0,0"
				VerticalAlignment="Center"
				
				
				Foreground="{DynamicResource Text.VeryHighContrast}"
				Text="{Binding DisplayName}"
				TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>
		<DataTemplate x:Key="CompactGroupTemplate" DataType="{x:Type yggdrasil:Group}">
			<Grid Height="22" Margin="8,1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="18" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<global:SliceControl
				Grid.Column="0"
				Width="14"
				Height="14"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				DefaultIndex="21"
				ElementCount="22"
				HoverIndex="-1"
				PressedIndex="-1"
				SliceMode="0"
				Source="Assets/Universal/Icon/skype-status-small.png"
				StackDirection="Horizontal" />
				<TextBlock
				x:Name="compactGroupName"
				Grid.Column="1"
				Margin="6,0,0,0"
				VerticalAlignment="Center"
				
				
				Foreground="{DynamicResource Text.VeryHighContrast}"
				Text="{Binding DisplayName}"
				TextTrimming="CharacterEllipsis" />
			</Grid>

		</DataTemplate>
		<!--  COMPACT RECENTS TEMPLATES END  -->
		
	</Window.Resources>
	<Window.DataTemplates>
		
				<!--  User template  -->
		<DataTemplate DataType="{x:Type yggdrasil:DirectMessage}">
			<Grid Height="32" Margin="2,4,0,4">
				<Grid.RowDefinitions>
					<RowDefinition Height="2" />
					<RowDefinition Height="14" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="34" />
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--  Profile picture  -->
				<Grid
				Grid.RowSpan="3"
				Grid.Column="0"
				Width="32"
				Height="32"
				Margin="2,0,0,0">
					<Border Background="Transparent">
						<Border.Effect>
							<DropShadowEffect
							BlurRadius="2"
							OffsetX="0" OffsetY="1"

							Color="{DynamicResource Avatar.Shadow}" />
						</Border.Effect>
						<Grid>
							<Image Stretch="UniformToFill">
								<Image.Source>
									<MultiBinding Converter="{StaticResource AvatarConverter}">
										<Binding Path="Avatar" />
										<Binding Source="user" />
									</MultiBinding>
								</Image.Source>
							</Image>
							<Border BorderBrush="{DynamicResource Avatar.Border}" BorderThickness="1" />
						</Grid>
					</Border>
				</Grid>
				<global:SliceControl
				Grid.Row="1"
				Grid.Column="1"
				Width="14"
				Margin="10,0,0,0"
				HorizontalAlignment="Left"
				DefaultIndex="{Binding Partner.ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
				ElementCount="22"
				HoverIndex="-1"
				PressedIndex="-1"
				SliceMode="0"
				Source="Assets/Universal/Icon/skype-status-small.png"
				StackDirection="Horizontal" />
				<!--  Name + status text  -->
				<TextBlock
				x:Name="usernameText"
				Grid.Row="1"
				Grid.Column="2"
				Margin="10,0,0,0"
				Theme="{StaticResource ContactUsernameStyle}"
				Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToWhite}}"
				Text="{Binding DisplayName}" />
				<TextBlock
				x:Name="statusText"
				Grid.Row="2"
				Grid.Column="2"
				Margin="10,1,0,0"
				Theme="{StaticResource ContactStatusStyle}"
				Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToWhiteFromLow}}"
				Text="{Binding Partner.Status, TargetNullValue=''}" />
			</Grid>
		</DataTemplate>
		<!--  Group template  -->
		<DataTemplate DataType="{x:Type yggdrasil:Group}">
			<Grid Height="32" Margin="2,4,0,4">
				<Grid.RowDefinitions>
					<RowDefinition Height="2" />
					<RowDefinition Height="14" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="34" />
					<ColumnDefinition Width="24" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--  Profile picture  -->
				<Grid
				Grid.RowSpan="3"
				Grid.Column="0"
				Width="32"
				Height="32"
				Margin="2,0,0,0">
					<Border Background="Transparent">
						<Border.Effect>
							<DropShadowEffect
							BlurRadius="2"
							OffsetX="0" OffsetY="1"

							Color="{DynamicResource Avatar.Shadow}" />
						</Border.Effect>
						<Grid>
							<Image Stretch="UniformToFill">
								<Image.Source>
									<MultiBinding Converter="{StaticResource AvatarConverter}">
										<Binding Path="Avatar" />
										<Binding Source="group" />
									</MultiBinding>
								</Image.Source>
							</Image>
							<Border BorderBrush="{DynamicResource Avatar.Border}" BorderThickness="1" />
						</Grid>
					</Border>
				</Grid>
				<global:SliceControl
				Grid.Row="1"
				Grid.Column="1"
				Width="14"
				Margin="10,0,0,0"
				HorizontalAlignment="Left"
				DefaultIndex="21"
				ElementCount="22"
				HoverIndex="-1"
				PressedIndex="-1"
				SliceMode="0"
				Source="Assets/Universal/Icon/skype-status-small.png"
				StackDirection="Horizontal" />
				<!--  Name + member count  -->
				<TextBlock
				x:Name="usernameText"
				Grid.Row="1"
				Grid.Column="2"
				Margin="10,0,0,0"
				Theme="{StaticResource ContactUsernameStyle}"
				Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToWhite}}"
				Text="{Binding DisplayName}" />
				<TextBlock
				x:Name="statusText"
				Grid.Row="2"
				Grid.Column="2"
				Margin="10,1,0,0"
				Theme="{StaticResource ContactStatusStyle}"
				Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource SelectedToWhiteFromLow}}"
				Text="{Binding Members.Length, StringFormat={}{0} members}" />
			</Grid>
		</DataTemplate>
		<!--  Server template  -->
		<DataTemplate DataType="{x:Type global:CategoryHeaderItem}">
								<Border
								Height="20"
								Margin="0"
								Padding="8,0"
								Background="{DynamicResource Sidebar.Header}">
									<TextBlock
									Margin="2,0,0,1"
									VerticalAlignment="Center"
									
									
									Foreground="{DynamicResource Text.VeryHighContrast}"
									Text="{Binding CategoryName}" />
								</Border>
							</DataTemplate>
							<DataTemplate DataType="{x:Type yggdrasil:ServerChannel}">
								<Grid Height="22" Margin="0,0,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="24" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<global:SliceControl
									Grid.Column="0"
									Width="14"
									Margin="10,0,0,0"
									HorizontalAlignment="Left"
									DefaultIndex="{Binding ChannelType, Converter={StaticResource ChannelTypeConverter}}"
									ElementCount="11"
									HoverIndex="-1"
									PressedIndex="-1"
									SliceMode="0"
									Source="Assets/Universal/Icon/skype-channel.png"
									StackDirection="Horizontal" />
									<TextBlock
									x:Name="channelText"
									Grid.Column="1"
									Margin="10,0,0,0"
									VerticalAlignment="Center"
									
									Theme="{StaticResource ContactStatusStyle}"
									Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource SelectedToWhite}}"
									Text="{Binding DisplayName}" />
								</Grid>
							</DataTemplate>
		<TreeDataTemplate DataType="{x:Type yggdrasil:Server}" ItemsSource="{Binding GroupedChannels}">
			<Grid Height="32" Margin="2,4,0,4">
				<Grid.RowDefinitions>
					<RowDefinition Height="2" />
					<RowDefinition Height="14" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="34" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<!--  Profile picture  -->
				<Grid
				Grid.RowSpan="3"
				Grid.Column="0"
				Width="32"
				Height="32"
				Margin="2,0,0,0">
					<Border Background="Transparent">
						<Border.Effect>
							<DropShadowEffect
							BlurRadius="2"
							OffsetX="0" OffsetY="1"

							Color="{DynamicResource Avatar.Shadow}" />
						</Border.Effect>
						<Grid>
							<Image Stretch="UniformToFill">
								<Image.Source>
									<MultiBinding Converter="{StaticResource AvatarConverter}">
										<Binding Path="Avatar" />
										<Binding Source="group" />
									</MultiBinding>
								</Image.Source>
							</Image>
							<Border BorderBrush="{DynamicResource Avatar.Border}" BorderThickness="1" />
						</Grid>
					</Border>
				</Grid>
				<TextBlock
				x:Name="usernameText"
				Grid.Row="1"
				Grid.Column="1"
				Margin="10,0,0,0"
				Theme="{StaticResource ContactUsernameStyle}"
				Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource SelectedToWhite}}"
				Text="{Binding DisplayName}" />
				<TextBlock
				x:Name="statusText"
				Grid.Row="2"
				Grid.Column="1"
				Margin="10,1,0,0"
				Theme="{StaticResource ContactStatusStyle}"
				Foreground="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource SelectedToWhiteFromLow}}"
				Text="{Binding MemberCount, StringFormat={}{0} members}" />
				<ToggleButton
				Grid.RowSpan="3"
				Grid.Column="2"
				Width="16"
				Height="16"
				Margin="0,0,4,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=TwoWay}">
					<ToggleButton.Template>
						<ControlTemplate TargetType="ToggleButton">
							<Grid Width="12" Height="12">
								<Image
								Width="12"
								Height="12"
								Source="Assets/Universal/Main/collapse-toggle-background.png" />
<Image
    x:Name="ToggleImage"
    Width="12"
    Height="12"
    RenderTransformOrigin="0.5,0.5"
    Source="Assets/Universal/Main/collapse-toggle-arrow.png">
    <Image.RenderTransform>
        <RotateTransform Angle="{Binding IsChecked,
            RelativeSource={RelativeSource AncestorType=ToggleButton},
            Converter={StaticResource BoolToAngle}}" />
    </Image.RenderTransform>
</Image>
							</Grid>
						</ControlTemplate>
					</ToggleButton.Template>
				</ToggleButton>
			</Grid>
		</TreeDataTemplate>
		<!--  CONTACT ITEM TEMPLATE END  -->
		<!--  CONVERSATION ITEM TEMPLATES START  -->
<!--  MessageItem Template  -->
<DataTemplate DataType="{x:Type yggdrasil:ActionMessage}">
	<Grid HorizontalAlignment="Stretch">
		<Grid
		x:Name="ConversationGrid"
		MaxWidth="626"
		Margin="0,10,65,0"
		HorizontalAlignment="Stretch">
			<!--  148 + 428 + 50  -->
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="148" />
				<ColumnDefinition Width="*" MaxWidth="428" />
				<ColumnDefinition Width="50" />
			</Grid.ColumnDefinitions>
			<!--  Center area  -->
			<!--  Reply header  -->
			<Grid
			Grid.Row="0"
			Grid.Column="1"
			Margin="0,0,20,2"
			IsVisible="{Binding ParentMessage, Converter={StaticResource NullDependentVisibilityConverter}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Image
				Grid.Column="0"
				Width="12"
				Margin="0,0,6,0"
				VerticalAlignment="Center"

				Source="Assets/Themeable/Main/reply-arrow.png" />
				<TextBlock
				Grid.Column="1"
				
				
				Foreground="{DynamicResource Text.LowContrast}"
				LineHeight="1"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap">
					<TextBlock.Text>
						<MultiBinding StringFormat="Replying to {0} - &quot;{1}&quot;">
							<Binding Path="ParentMessage.Author.DisplayName" />
							<Binding Converter="{StaticResource ReplyBodyConverter}" Path="ParentMessage.Text" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</Grid>
			<!--  Message body + attachment  -->
			<StackPanel
			Grid.Row="1"
			Grid.Column="1"
			Margin="0,0,20,0"
			Orientation="Vertical">
				<ContentControl Content="{Binding Converter={StaticResource FormatFullActionMessageConverter}}" IsVisible="{Binding Text, Converter={StaticResource NullDependentVisibilityConverter}}" />
				<Image
				MaxWidth="300"
				MaxHeight="300"
				Margin="{Binding Converter={StaticResource NullDependentMarginConverter}}"
				HorizontalAlignment="Left"
				Cursor="Hand"
				Source="{Binding Attachments, Converter={StaticResource MsgByteArrayToImageConverter}}"
				Stretch="Uniform"
				PointerReleased="OpenImage_Click"
				IsVisible="{Binding Attachments, Converter={StaticResource NullDependentVisibilityConverter}}">
				</Image>
			</StackPanel>
			<!--  Timestamp  -->
			<Grid
			Grid.Row="1"
			Grid.Column="2"
			HorizontalAlignment="Left"
			VerticalAlignment="Top">
				<TextBlock
				
				
				Foreground="{DynamicResource Text.LowContrast}"
				Text="{Binding Time, StringFormat=h:mm tt}"
				IsVisible="{Binding Identifier, Converter={StaticResource PreviewVisibilityConverter}, ConverterParameter=invert}" />
				<global:SliceControl
				Width="10"
				Height="10"
				AnimationFps="60"
				DefaultIndex="0"
				ElementCount="72"
				IsAnimation="True"
				SliceMode="0"
				Source="Assets/Universal/Main/loading.png"
				StackDirection="Vertical"
				IsVisible="{Binding Identifier, Converter={StaticResource PreviewVisibilityConverter}}" />
			</Grid>
		</Grid>
	</Grid>
</DataTemplate>
<DataTemplate DataType="{x:Type yggdrasil:Message}">
	<Grid HorizontalAlignment="Stretch" Tag="{DynamicResource Lang}">
		<Grid
		x:Name="ConversationGrid"
		MaxWidth="626"
		Margin="0,10,65,0"
		HorizontalAlignment="Stretch"
		Background="Transparent"
		Tag="{DynamicResource Lang}">
			<!--  148 + 428 + 50  -->
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="148" />
				<ColumnDefinition Width="*" MaxWidth="428" />
				<ColumnDefinition Width="50" />
			</Grid.ColumnDefinitions>
			<Grid.ContextMenu>
				<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
					<!--  Copy selected  -->
					<MenuItem Header="{Binding Path=PlacementTarget.Tag[sF_CHAT_FORM_IMGRID_PMENUITEM_COPY], RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
					<!--  Copy message  -->
					<MenuItem
					Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=CopyMessageCommand}"
					CommandParameter="{Binding}"
					Header="{Binding Path=PlacementTarget.Tag[sCHAT_MENU_COPY_MESSAGE], RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
					<!--  Select all  -->
					<MenuItem Header="{Binding Path=PlacementTarget.Tag[sF_CHAT_FORM_IMGRID_PMENUITEM_SELALL], RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
					<Separator />
					<!--  Reply  -->
					<MenuItem
					Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=ReplyToMessageCommand}"
					CommandParameter="{Binding}"
					Header="Reply" />
					<!--  Edit  -->
					<MenuItem
					Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=EditMessageCommand}"
					CommandParameter="{Binding}"
					Header="{Binding Path=PlacementTarget.Tag[sCHAT_EDIT_MESSAGE], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
					IsVisible="{Binding Author.Identifier, Converter={StaticResource IsCurrentUserToVisibilityConverter}}" />
					<!--  Delete  -->
					<MenuItem
					Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=DeleteMessageCommand}"
					CommandParameter="{Binding}"
					Header="{Binding Path=PlacementTarget.Tag[sCHAT_MENU_REMOVE_MESSAGE], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
					IsVisible="{Binding Author.Identifier, Converter={StaticResource IsCurrentUserToVisibilityConverter}}" />
					<!--  Move bookmark  -->
					<MenuItem
					Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=MoveBookmarkCommand}"
					CommandParameter="{Binding}"
					Header="{Binding Path=PlacementTarget.Tag[sCHAT_MENU_MOVE_BOOKMARK], RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
				</ContextMenu>
			</Grid.ContextMenu>
			<!--  Sender name  -->
			<TextBlock
			Grid.Row="1"
			Grid.Column="0"
			Margin="0,0,16,0"
			HorizontalAlignment="Right"
			VerticalAlignment="Top"
			
			
			TextTrimming="CharacterEllipsis">
				<TextBlock.Foreground>
					<MultiBinding Converter="{StaticResource SenderToColorConverter}">
						<Binding Path="Author.Identifier" />
						<Binding Path="IsForwarded" />
					</MultiBinding>
				</TextBlock.Foreground>
				<TextBlock.Text>
					<MultiBinding Converter="{StaticResource ForwardedMessageStatusConverter}">
						<Binding Path="Author.DisplayName" />
						<Binding Path="IsForwarded" />
					</MultiBinding>
				</TextBlock.Text>
				<TextBlock.IsVisible>
					<MultiBinding Converter="{StaticResource IDToVisibilityConverter}">
						<Binding Path="PreviousMessageIdentifier" />
						<Binding Path="Author.Identifier" />
						<Binding Path="PreviousMessageIsAction" />
					</MultiBinding>
				</TextBlock.IsVisible>
			</TextBlock>
			<!--  Center area  -->
			<!--  Reply header  -->
			<Grid
			Grid.Row="0"
			Grid.Column="1"
			Margin="0,0,20,2"
			IsVisible="{Binding ParentMessage, Converter={StaticResource NullDependentVisibilityConverter}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Image
				Grid.Column="0"
				Width="12"
				Margin="0,0,6,0"
				VerticalAlignment="Center"

				Source="Assets/Themeable/Main/reply-arrow.png" />
				<TextBlock
				Grid.Column="1"
				
				
				Foreground="{DynamicResource Text.LowContrast}"
				LineHeight="1"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap">
					<TextBlock.Text>
						<MultiBinding StringFormat="Replying to {0} - &quot;{1}&quot;">
							<Binding Path="ParentMessage.Author.DisplayName" />
							<Binding Converter="{StaticResource ReplyBodyConverter}" Path="ParentMessage.Text" />
						</MultiBinding>
					</TextBlock.Text>
				</TextBlock>
			</Grid>
			<!--  Message body + attachment  -->
			<StackPanel
			Grid.Row="1"
			Grid.Column="1"
			Margin="0,0,20,0"
			Orientation="Vertical">
				<ContentControl Content="{Binding Text, Converter={StaticResource FormatFullTextConverter}}" IsVisible="{Binding Text, Converter={StaticResource NullDependentVisibilityConverter}}" />
				<Image
				MaxWidth="300"
				MaxHeight="300"
				Margin="{Binding Text, Converter={StaticResource NullDependentMarginConverter}}"
				HorizontalAlignment="Left"
				Cursor="Hand"
				Source="{Binding Attachments, Converter={StaticResource MsgByteArrayToImageConverter}}"
				Stretch="Uniform"
				PointerReleased="OpenImage_Click"
				IsVisible="{Binding Attachments, Converter={StaticResource NullDependentVisibilityConverter}}">
				</Image>
			</StackPanel>
			<!--  Timestamp  -->
			<Grid
			Grid.Row="1"
			Grid.Column="2"
			HorizontalAlignment="Left"
			VerticalAlignment="Top">
				<TextBlock
				
				
				Foreground="{DynamicResource Text.LowContrast}"
				Text="{Binding Time, StringFormat=h:mm tt}"
				IsVisible="{Binding Identifier, Converter={StaticResource PreviewVisibilityConverter}, ConverterParameter=invert}" />
				<global:SliceControl
				Width="10"
				Height="10"
				AnimationFps="60"
				DefaultIndex="0"
				ElementCount="72"
				IsAnimation="True"
				SliceMode="0"
				Source="Assets/Universal/Main/loading.png"
				StackDirection="Vertical"
				IsVisible="{Binding Identifier, Converter={StaticResource PreviewVisibilityConverter}}" />
			</Grid>
		</Grid>
	</Grid>
</DataTemplate>
<!--  CallStartedItem Template  -->
<DataTemplate DataType="{x:Type yggdrasil:CallStartedNotice}">
	<Grid Margin="0,9.5,0,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="114" />
			<ColumnDefinition Width="430" />
			<ColumnDefinition Width="80" />
		</Grid.ColumnDefinitions>
		<TextBlock
		Grid.Column="1"
		
		
		Foreground="{DynamicResource Text.LowContrast}"
		Text="{Binding StartedBy, StringFormat='Call started by: {0}'}" />
		<TextBlock
		Grid.Column="2"
		HorizontalAlignment="Left"
		VerticalAlignment="Top"
		
		
		Foreground="{DynamicResource Text.LowContrast}"
		Text="{Binding Time, StringFormat=h:mm tt}" />
	</Grid>
</DataTemplate>
<!--  CallEndedItem Template  -->
<DataTemplate DataType="{x:Type yggdrasil:CallEndedNotice}">
	<Grid Margin="0,9.5,0,0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="114" />
			<ColumnDefinition Width="430" />
			<ColumnDefinition Width="80" />
		</Grid.ColumnDefinitions>
		<TextBlock
		Grid.Column="1"
		
		
		Foreground="{DynamicResource Text.LowContrast}"
		Text="{Binding Duration, StringFormat='Call ended, duration: {0}'}" />
		<TextBlock
		Grid.Column="2"
		HorizontalAlignment="Left"
		VerticalAlignment="Top"
		
		
		Foreground="{DynamicResource Text.LowContrast}"
		Text="{Binding Time, StringFormat=h:mm tt}" />
	</Grid>
</DataTemplate>
<!--  CONVERSATION ITEM TEMPLATE END  -->
	</Window.DataTemplates>
	<Grid x:Name="FrameArea">
		<Grid
		x:Name="TitleBar"
		Height="25"
		VerticalAlignment="Top"
		Background="{DynamicResource Active.Titlebar}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="121" />
			</Grid.ColumnDefinitions>
			<StackPanel
			x:Name="CaptionButtons"
			Grid.Column="1"
			Margin="0,0,5,0"
			Orientation="Horizontal">
				<global:SliceControl
				x:Name="split"
				Width="26"
				PointerEntered="TitleButton_PointerEntered"
				PointerExited="TitleButton_PointerExited"
				PointerReleased="TitleButton_Click"
				Source="Assets/Universal/Window Frame/Basic/split/combined.png"
				Classes="windowButton" />
				<global:SliceControl
				x:Name="minimize"
				Width="24"
				PointerEntered="TitleButton_PointerEntered"
				PointerExited="TitleButton_PointerExited"
				PointerReleased="TitleButton_Click"
				Source="Assets/Universal/Window Frame/Basic/minimize/combined.png"
				Classes="windowButton" />
				<global:SliceControl
				x:Name="maximize"
				Width="24"
				PointerEntered="TitleButton_PointerEntered"
				PointerExited="TitleButton_PointerExited"
				PointerReleased="TitleButton_Click"
				Source="Assets/Universal/Window Frame/Basic/maximize/combined.png"
				Classes="windowButton" />
				<global:SliceControl
				x:Name="close"
				Width="42"
				PointerEntered="TitleButton_PointerEntered"
				PointerExited="TitleButton_PointerExited"
				PointerReleased="TitleButton_Click"
				Source="Assets/Universal/Window Frame/Basic/close/combined.png"
				Classes="windowButton" />
			</StackPanel>
			<StackPanel
			Grid.Column="0"
			HorizontalAlignment="Left"
			Orientation="Horizontal">
				<Image
				x:Name="TitleBarIcon"
				Margin="8,0,0,0"
				VerticalAlignment="Center"
				PointerPressed="TitleBarIcon_PointerPressed"
				Source="Assets/Universal/Branding/logo-window-frame.png"
				Theme="{StaticResource LongIconStyle}" />
				<Grid Margin="6,0">
					<TextBlock
					x:Name="TitleShadow"
					Foreground="White"
					Theme="{StaticResource TitlebarTextStyle}">
						<TextBlock.Effect>
							<BlurEffect  Radius="15.0" />
						</TextBlock.Effect>
					</TextBlock>
					<TextBlock
					x:Name="TitleShadow2"
					Foreground="White"
					Theme="{StaticResource TitlebarTextStyle}">
						<TextBlock.Effect>
							<BlurEffect  Radius="20.0" />
						</TextBlock.Effect>
					</TextBlock>
					<TextBlock
					x:Name="TitleShadow3"
					Foreground="White"
					Theme="{StaticResource TitlebarTextStyle}">
						<TextBlock.Effect>
							<BlurEffect  Radius="17.0" />
						</TextBlock.Effect>
					</TextBlock>
					<TextBlock
					x:Name="TitleMain"
					Foreground="{DynamicResource Text.HighContrast}"
					Theme="{StaticResource TitlebarTextStyle}"
					IsVisible="True" />
				</Grid>
			</StackPanel>
		</Grid>
		<Grid
		x:Name="WindowArea"
		Margin="4,25,4,4"
		PointerPressed="WindowArea_PointerPressed">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<StackPanel
			x:Name="MenuBarArea"
			Grid.Row="0"
			Orientation="Vertical">
				<controls:MainMenuBar x:Name="MenuBar"/>
				<Rectangle
				x:Name="MenuBarDivider"
				Height="1"
				VerticalAlignment="Top"
				Fill="{DynamicResource Active.Background}" />
			</StackPanel>
			<Grid Grid.Row="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="71" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Rectangle
				x:Name="ContentBgTop"
				Grid.Row="0"
				Fill="{DynamicResource Active.Window}" />
				<Rectangle
				x:Name="ContentBgBottom"
				Grid.Row="1"
				Fill="{DynamicResource Active.Background}" />
				<Border Grid.RowSpan="2" BorderThickness="4">
					<Grid>
						<ContentControl x:Name="FillWindowHost" />
						<Grid x:Name="ContentArea">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
								
								Width="300"
								MinWidth="160" />
								<ColumnDefinition  Width="4" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid x:Name="Sidebar" Grid.Column="0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<StackPanel Grid.Row="0">
									<Grid x:Name="SidebarStatus" VerticalAlignment="Top">
										<Grid.RowDefinitions>
											<RowDefinition Height="32" />
											<RowDefinition Height="32" />
										</Grid.RowDefinitions>
										<global:SliceControl
										x:Name="StatusBox"
										Grid.Row="0"
										HorizontalAlignment="Stretch"
										ButtonStateOnInit="Pressed"
										DefaultIndex="0"
										ElementCount="5"
										HoverIndex="1"
										IsRadioButton="True"
										PointerReleased="Chat_Close"
										PressedIndex="2"
										Source="Assets/Themeable/Main/status-top.png"
										StackDirection="Vertical"
										Text="Saul Goodman"
										TextColor="#FFFFFF"
										TextFont="Arial"
										TextLeftMargin="43"
										TextRightMargin="30"
										TextSize="13"
										TextWeight="Bold"
										Themeable="True" />
										<StackPanel
										x:Name="StatusArea"
										Grid.Row="0"
										Height="20"
										Margin="9,0,0,0"
										HorizontalAlignment="Left"
										IsHitTestVisible="True"
										PointerReleased="StatusArea_Click"
										Orientation="Horizontal">
											<StackPanel.Resources>
												<ContextMenu x:Key="StatusMenu">
													<MenuItem
													x:Name="sm_online"
													Click="StatusMenuItemClick"
													Header="{Binding [sSTATUSMENU_CAPTION_ONLINE], Source={StaticResource Lang}}">
														<MenuItem.Icon>
															<global:SliceControl
															Width="14"
															DefaultIndex="2"
															ElementCount="22"
															HoverIndex="-1"
															PressedIndex="-1"
															SliceMode="0"
															Source="Assets/Universal/Icon/skype-status-small.png"
															StackDirection="Horizontal" />
														</MenuItem.Icon>
													</MenuItem>
													<MenuItem
													x:Name="sm_away"
													Click="StatusMenuItemClick"
													Header="{Binding [sSTATUSMENU_CAPTION_AWAY], Source={StaticResource Lang}}">
														<MenuItem.Icon>
															<global:SliceControl
															Width="14"
															DefaultIndex="3"
															ElementCount="22"
															HoverIndex="-1"
															PressedIndex="-1"
															SliceMode="0"
															Source="Assets/Universal/Icon/skype-status-small.png"
															StackDirection="Horizontal" />
														</MenuItem.Icon>
													</MenuItem>
													<MenuItem
													x:Name="sm_dnd"
													Click="StatusMenuItemClick"
													Header="{Binding [sSTATUSMENU_CAPTION_DND], Source={StaticResource Lang}}">
														<MenuItem.Icon>
															<global:SliceControl
															Width="14"
															DefaultIndex="5"
															ElementCount="22"
															HoverIndex="-1"
															PressedIndex="-1"
															SliceMode="0"
															Source="Assets/Universal/Icon/skype-status-small.png"
															StackDirection="Horizontal" />
														</MenuItem.Icon>
													</MenuItem>
													<MenuItem
													x:Name="sm_invisible"
													Click="StatusMenuItemClick"
													Header="{Binding [sSTATUSMENU_CAPTION_INVISIBLE], Source={StaticResource Lang}}">
														<MenuItem.Icon>
															<global:SliceControl
															Width="14"
															DefaultIndex="14"
															ElementCount="22"
															HoverIndex="-1"
															PressedIndex="-1"
															SliceMode="0"
															Source="Assets/Universal/Icon/skype-status-small.png"
															StackDirection="Horizontal" />
														</MenuItem.Icon>
													</MenuItem>
													<MenuItem
													x:Name="sm_offline"
													Click="StatusMenuItemClick"
													Header="{Binding [sSTATUSMENU_CAPTION_OFFLINE], Source={StaticResource Lang}}"
													IsEnabled="False">
														<MenuItem.Icon>
															<global:SliceControl
															Width="14"
															DefaultIndex="14"
															ElementCount="22"
															HoverIndex="-1"
															PressedIndex="-1"
															SliceMode="0"
															Source="Assets/Universal/Icon/skype-status-small.png"
															StackDirection="Horizontal" />
														</MenuItem.Icon>
													</MenuItem>
													<Separator />
													<MenuItem
													x:Name="sm_call_forwarding"
													Click="StatusMenuItemClick"
													Header="{Binding [sSTATUSMENU_CAPTION_CF_OPTIONS2], Source={StaticResource Lang}}">
														<MenuItem.Icon>
															<global:SliceControl
															Width="14"
															DefaultIndex="13"
															ElementCount="22"
															HoverIndex="-1"
															PressedIndex="-1"
															SliceMode="0"
															Source="Assets/Universal/Icon/skype-status-small.png"
															StackDirection="Horizontal" />
														</MenuItem.Icon>
													</MenuItem>
												</ContextMenu>
											</StackPanel.Resources>
											<global:SliceControl
											x:Name="StatusIcon"
											Grid.Row="0"
											Width="16"
											HorizontalAlignment="Left"
											DefaultIndex="0"
											ElementCount="22"
											HoverIndex="-1"
											PressedIndex="-1"
											SliceMode="0"
											Source="Assets/Universal/Icon/skype-status.png"
											StackDirection="Horizontal" />
											<Image
											Grid.Row="0"
											Width="12"
											Height="16"
											Margin="0,0,0,0"
											HorizontalAlignment="Left"
											Source="Assets/Themeable/Main/dropdown.png" />
										</StackPanel>
										<global:SliceControl
										x:Name="SBHomeButton"
										Grid.Row="0"
										Width="16"
										Margin="0,0,11,0"
										HorizontalAlignment="Right"
										ButtonStateOnInit="Pressed"
										DefaultIndex="0"
										ElementCount="3"
										HoverIndex="1"
										Interactive="False"
										PressedIndex="2"
										SliceMode="0"
										Source="Assets/Themeable/Main/home.png"
										StackDirection="Horizontal"
										Themeable="True" />
										<global:SliceControl
										x:Name="SkypeCreditBox"
										Grid.Row="1"
										HorizontalAlignment="Stretch"
										DefaultIndex="0"
										ElementCount="5"
										HoverIndex="-1"
										Interactive="False"
										PressedIndex="-1"
										Source="Assets/Themeable/Main/status-bottom.png"
										StackDirection="Vertical"
										Text="{Binding [sACCOUNT_PANEL_NO_SUBSCRIPTION], Source={StaticResource Lang}, StringFormat=$ 0.00 - {0}}"
										TextColor="{DynamicResource Text.HighContrast}"
										TextFont="Tahoma"
										TextLeftMargin="34"
										TextSize="11"
										Themeable="True" />
										<Image
										Grid.Row="1"
										Width="16"
										Height="16"
										Margin="9,0,0,0"
										HorizontalAlignment="Left"
										Source="Assets/Universal/Main/credit.png" />
									</Grid>
									<Grid x:Name="SidebarTabs" Margin="0,4,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition  Width="*" />
											<ColumnDefinition  Width="*" />
											<ColumnDefinition  Width="*" />
										</Grid.ColumnDefinitions>
										<global:SliceControl
										x:Name="btnContacts"
										Grid.Column="0"
										HorizontalAlignment="Stretch"
										DefaultIndex="1"
										ElementCount="5"
										HoverIndex="-1"
										IsRadioButton="True"
										LeftWidth="25"
										PointerReleased="SidebarTab_BtnDown"
										PressedIndex="2"
										RightWidth="2"
										Source="Assets/Themeable/Main/contacts.png"
										StackDirection="Vertical"
										Text="{Binding [sZAPBUTTON_CONTACTS], Source={StaticResource Lang}}"
										TextColor="{DynamicResource Text.HighContrast}"
										TextFont="Arial"
										TextLeftMargin="30"
										TextSize="13"
										TextWeight="Bold"
										Themeable="True" />
										<global:SliceControl
										x:Name="btnServers"
										Grid.Column="1"
										HorizontalAlignment="Stretch"
										DefaultIndex="0"
										ElementCount="5"
										HoverIndex="-1"
										IsRadioButton="True"
										LeftWidth="25"
										PointerReleased="SidebarTab_BtnDown"
										PressedIndex="2"
										RightWidth="2"
										Source="Assets/Themeable/Main/servers.png"
										StackDirection="Vertical"
										Text="Servers"
										TextColor="{DynamicResource Text.HighContrast}"
										TextFont="Arial"
										TextLeftMargin="28"
										TextSize="13"
										TextWeight="Bold"
										Themeable="True" />
										<global:SliceControl
										x:Name="btnRecents"
										Grid.Column="2"
										HorizontalAlignment="Stretch"
										ButtonStateOnInit="Pressed"
										DefaultIndex="1"
										ElementCount="5"
										HoverIndex="-1"
										IsRadioButton="True"
										LeftWidth="25"
										PointerReleased="SidebarTab_BtnDown"
										PressedIndex="2"
										RightWidth="2"
										Source="Assets/Themeable/Main/recents.png"
										StackDirection="Vertical"
										Text="{Binding [sRECENTS_TAB_TEXT], Source={StaticResource Lang}}"
										TextColor="{DynamicResource Text.HighContrast}"
										TextFont="Arial"
										TextLeftMargin="30"
										TextSize="13"
										TextWeight="Bold"
										Themeable="True" />
									</Grid>
								</StackPanel>
								<Border
								Grid.Row="1"
								BorderBrush="{DynamicResource Card.Border}"
								BorderThickness="1,0,1,0">
									<Grid x:Name="ContactsArea">
										<Grid.RowDefinitions>
											<RowDefinition Height="31" />
											<RowDefinition Height="1" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<global:SliceControl
										x:Name="PseudoSearchBox"
										Grid.Row="0"
										HorizontalAlignment="Stretch"
										Cursor="IBeam"
										DefaultIndex="1"
										ElementCount="2"
										HoverIndex="-1"
										Interactive="False"
										PressedIndex="0"
										Source="Assets/Themeable/Main/search-box.png"
										StackDirection="Vertical"
										Themeable="True" />
										<TextBox
										x:Name="SearchBox"
										Grid.Row="0"
										Padding="33,0,0,0"
										HorizontalAlignment="Stretch"
										VerticalContentAlignment="Center"
										Background="Transparent"
										BorderThickness="0"
										Cursor="IBeam"
										
										
										GotFocus="SearchBox_Focused"
										LostFocus="SearchBox_Unfocused" />
										<Rectangle
										Grid.Row="1"
										Height="1"
										Fill="{DynamicResource Sidebar.Divider.Opaque}" />
										<ListBox
										x:Name="ConversationList"
										Grid.Row="2"
										BorderThickness="0"
										PointerReleased="ConversationList_ItemClicked"
										
										ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										Theme="{StaticResource NoInsetListBox}">
											<ListBox.ItemsPanel>
												<ItemsPanelTemplate>
													<VirtualizingStackPanel />
												</ItemsPanelTemplate>
											</ListBox.ItemsPanel>
											<ListBox.Styles>
												<Style Selector="ListBoxItem">
													<Setter Property="HorizontalContentAlignment" Value="Stretch" />
													<Setter Property="Padding" Value="0" />
													<Setter Property="Focusable" Value="True" />
													<Setter Property="IsEnabled" Value="True" />
													<Setter Property="Template">
														<Setter.Value>
															<ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="ItemBorder"
            Background="{Binding IsSelected,
                RelativeSource={RelativeSource TemplatedParent},
                Converter={StaticResource SelectedToSelectionBrush}}">
        <ContentPresenter Name="PART_ContentPresenter"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
</ControlTemplate>
														</Setter.Value>
													</Setter>
												</Style>
											</ListBox.Styles>
										</ListBox>
										<TreeView
										x:Name="ServersList"
										Grid.Row="2"
										Background="{DynamicResource Card.Background}"
										BorderThickness="0"
										ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										ScrollViewer.VerticalScrollBarVisibility="Visible"
										IsVisible="False">
											<TreeView.Styles>
												<Style Selector="TreeViewItem">
													<Setter Property="IsExpanded" Value="False" />
													<Setter Property="Padding" Value="0" />
													<Setter Property="BorderThickness" Value="0" />
													
													<Setter Property="Template">
														<Setter.Value>
															<ControlTemplate TargetType="TreeViewItem">
    <StackPanel>
        <Border x:Name="ItemBorder"
                Background="{Binding IsSelected,
                    RelativeSource={RelativeSource TemplatedParent},
                    Converter={StaticResource SelectedToSelectionBrush}}">
            <ContentPresenter Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}" />
        </Border>
        <ItemsPresenter Name="PART_ItemsPresenter"
                        ItemsPanel="{TemplateBinding ItemsPanel}"
                        IsVisible="{TemplateBinding IsExpanded}" />
    </StackPanel>
</ControlTemplate>
														</Setter.Value>
													</Setter>
												</Style>
											</TreeView.Styles>
										</TreeView>

									</Grid>
								</Border>

								<StackPanel Grid.Row="2" Orientation="Vertical">
									<Grid x:Name="SidebarAddButtons" Grid.Row="4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" MinWidth="117" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<global:SliceControl
										x:Name="AddContactButton"
										Grid.Column="0"
										HorizontalAlignment="Stretch"
										DefaultIndex="0"
										ElementCount="3"
										HoverIndex="1"
										HoverTransition="False"
										PointerReleased="AddContact_Click"
										PressedIndex="2"
										Source="Assets/Themeable/Main/add-contact.png"
										StackDirection="Vertical"
										Classes="addButtonHover"
										Text="{Binding [sADD_CONTACT_LONG], Source={StaticResource Lang}}"
										TextFont="Tahoma"
										TextLeftMargin="41"
										TextSize="11"
										Themeable="True" />
										<global:SliceControl
										x:Name="MakeGroupButton"
										Grid.Column="1"
										HorizontalAlignment="Stretch"
										DefaultIndex="0"
										ElementCount="4"
										HoverIndex="1"
										HoverTransition="False"
										PointerReleased="MakeGroup_Click"
										PressedIndex="2"
										RightWidth="1"
										Source="Assets/Themeable/Main/create-group.png"
										StackDirection="Vertical"
										Classes="addButtonHover"
										Text="{Binding [sCREATE_GROUP_LONG], Source={StaticResource Lang}}"
										TextFont="Tahoma"
										TextLeftMargin="41"
										TextSize="11"
										Themeable="True" />
									</Grid>

									<Border BorderBrush="{DynamicResource Card.Border}" BorderThickness="1,0,1,0">
										<StackPanel Orientation="Vertical">
											<Rectangle Height="1" Fill="{DynamicResource Sidebar.Divider.Translucent}" />
											<global:SliceControl
											HorizontalAlignment="Stretch"
											DefaultIndex="0"
											ElementCount="5"
											HoverIndex="1"
											PointerReleased="CallPhones_Click"
											PressedIndex="2"
											Source="Assets/Themeable/Main/call-phones.png"
											StackDirection="Vertical"
											Text="{Binding [sZAPBUTTON_SKYPEOUT], Source={StaticResource Lang}}"
											TextColor="{DynamicResource Text.HighContrast}"
											TextFont="Arial"
											TextLeftMargin="32"
											TextSize="13"
											TextWeight="Bold"
											Themeable="True" />
											<Rectangle Height="1" Fill="{DynamicResource Sidebar.Divider.Translucent}" />
										</StackPanel>
									</Border>
									<global:SliceControl
									x:Name="GlobalUserCount"
									HorizontalAlignment="Stretch"
									DefaultIndex="0"
									ElementCount="1"
									Interactive="False"
									Source="Assets/Themeable/Main/user-count-background.png"
									StackDirection="Vertical"
									Text="Sky Multiprotocol. All rights reserved."
									TextColor="{DynamicResource Text.LowContrast}"
									TextFont="Tahoma"
									TextLeftMargin="7"
									TextSize="11"
									Themeable="True" />
								</StackPanel>

							</Grid>
							<ContentControl
							x:Name="SelectedItemHolder"
							Grid.Row="0"
							IsVisible="False" />
							<Rectangle
							x:Name="SkypeSplitter"
							Grid.Column="1"
							Cursor="SizeWestEast"
							Fill="Transparent"
							PointerPressed="SkypeSplitter_Press"
							PointerMoved="SkypeSplitter_PointerMoved" />
							<Grid
							x:Name="ChatArea"
							Grid.Column="2"
							DataContext="{Binding SelectedItem, ElementName=ConversationList}">

								<Grid.RowDefinitions>
									<RowDefinition  Height="32" />
									<RowDefinition
									
									Height="130"
									MinHeight="107"
									MaxHeight="171" />
									<RowDefinition  Height="4" />
									<RowDefinition  Height="*" />
								</Grid.RowDefinitions>
								<Grid
								x:Name="ChatTopbar"
								Grid.Row="0"
								IsVisible="True">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<global:SliceControl
									x:Name="chatHeader"
									Grid.Column="0"
									HorizontalAlignment="Stretch"
									DefaultIndex="0"
									ElementCount="5"
									HoverIndex="-1"
									PressedIndex="-1"
									Source="Assets/Themeable/Main/tab-left.png"
									StackDirection="Vertical"
									Text="{Binding DisplayName}"
									TextColor="{DynamicResource Text.HighContrast}"
									TextFont="Arial"
									TextLeftMargin="13"
									TextSize="13"
									TextWeight="Bold"
									Themeable="True" />
									<global:SliceControl
									x:Name="ChatCloseButton"
									Grid.Column="1"
									Width="NaN"
									HorizontalAlignment="Stretch"
									DefaultIndex="0"
									ElementCount="5"
									HoverIndex="1"
									PointerReleased="Chat_Close"
									PressedIndex="2"
									Source="Assets/Themeable/Main/tab-right.png"
									StackDirection="Vertical"
									Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_CLOSE]}"
									TextColor="{DynamicResource Text.HighContrast}"
									TextFont="Arial"
									TextLeftMargin="27"
									TextRightMargin="16"
									TextSize="13"
									TextWeight="Bold"
									Themeable="True" />
									<Image
									Grid.Column="1"
									Width="16"
									Height="16"
									Margin="7,0,0,0"
									HorizontalAlignment="Left"
									IsHitTestVisible="False"
									Source="Assets/Themeable/Main/close.png" />
								</Grid>
								<Grid
								x:Name="HomeTopbar"
								Grid.Row="0"
								IsVisible="False">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<global:SliceControl
									x:Name="MainPageButton"
									Grid.Column="0"
									HorizontalAlignment="Stretch"
									ButtonStateOnInit="Pressed"
									DefaultIndex="0"
									ElementCount="5"
									HoverIndex="-1"
									IsRadioButton="True"
									PressedIndex="2"
									Source="Assets/Themeable/Main/tab-left.png"
									StackDirection="Vertical"
									Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_SKYPEHOME]}"
									TextColor="{DynamicResource Text.HighContrast}"
									TextFont="Arial"
									TextLeftMargin="31"
									TextRightMargin="16"
									TextSize="13"
									TextWeight="Bold"
									Themeable="True" />
									<Image
									Grid.Column="0"
									Width="16"
									Height="16"
									Margin="8,0,0,0"
									HorizontalAlignment="Left"
									IsHitTestVisible="False"
									Source="Assets/Universal/Main/skypehome.png" />
									<global:SliceControl
									x:Name="ProfileButton"
									Grid.Column="1"
									HorizontalAlignment="Stretch"
									DefaultIndex="0"
									ElementCount="5"
									HoverIndex="1"
									IsRadioButton="False"
									PressedIndex="2"
									Source="Assets/Themeable/Main/tab-middle.png"
									StackDirection="Vertical"
									Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_PROFILE]}"
									TextColor="{DynamicResource Text.HighContrast}"
									TextFont="Arial"
									TextLeftMargin="31"
									TextRightMargin="16"
									TextSize="13"
									TextWeight="Bold"
									Themeable="True" />
									<Image
									Grid.Column="1"
									Width="16"
									Height="16"
									Margin="8,0,0,0"
									HorizontalAlignment="Left"
									IsHitTestVisible="False"
									Source="Assets/Universal/Main/profile.png" />
									<global:SliceControl
									x:Name="FeedbackButton"
									Grid.Column="2"
									HorizontalAlignment="Stretch"
									DefaultIndex="0"
									ElementCount="5"
									HoverIndex="1"
									IsRadioButton="False"
									PointerReleased="OnFeedbackClick"
									PressedIndex="2"
									Source="Assets/Themeable/Main/tab-middle.png"
									StackDirection="Vertical"
									Text="Report a bug"
									TextColor="{DynamicResource Text.HighContrast}"
									TextFont="Arial"
									TextLeftMargin="31"
									TextRightMargin="16"
									TextSize="13"
									TextWeight="Bold"
									Themeable="True" />
									<Image
									Grid.Column="2"
									Width="16"
									Height="16"
									Margin="8,0,0,0"
									HorizontalAlignment="Left"
									IsHitTestVisible="False"
									Source="Assets/Universal/Main/feedback.png" />
									<global:SliceControl
									Grid.Column="3"
									HorizontalAlignment="Stretch"
									DefaultIndex="0"
									ElementCount="5"
									HoverIndex="-1"
									PressedIndex="-1"
									Source="Assets/Themeable/Main/tab-right.png"
									StackDirection="Vertical"
									Themeable="True" />
								</Grid>
								<Border
								Grid.Row="1"
								Background="{DynamicResource Card.Background}"
								BorderBrush="{DynamicResource Card.Border}"
								BorderThickness="1,0,1,1"
								CornerRadius="0,0,4,4">
									<Grid>
										<ContentControl
										x:Name="HomeFrame"
										Grid.Row="1"/>
										<ContentControl x:Name="FillMessagePanelHost" IsVisible="False" />
										<ContentControl x:Name="ChatProfileArea" Content="{Binding DataContext, ElementName=ChatArea}">
											<ContentControl.DataTemplates>
												<DataTemplate DataType="{x:Type yggdrasil:DirectMessage}">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<!--  Profile picture column  -->
														<Image
														x:Name="CPAProfilePic"
														Grid.Column="0"
														Margin="4,4,5,9"
														HorizontalAlignment="Left"
														VerticalAlignment="Top"
														Stretch="UniformToFill">
															<Image.Source>
																<MultiBinding Converter="{StaticResource AvatarConverter}">
																	<Binding Path="Avatar" />
																	<Binding Source="user" />
																</MultiBinding>
															</Image.Source>
															<Image.Effect>
																<DropShadowEffect
																BlurRadius="4"
																OffsetX="0" OffsetY="1"

																Color="{DynamicResource Avatar.Shadow}" />
															</Image.Effect>
														</Image>
														<!--  Information column  -->
														<StackPanel
														Grid.Column="1"
														Margin="12,12"
														Orientation="Vertical">
															<!--  Text status row ("I'm bored", etc)  -->
															<StackPanel
															Margin="0,0,0,15"
															HorizontalAlignment="Left"
															Orientation="Horizontal"
															IsVisible="{Binding Partner.Status, Converter={StaticResource NullDependentVisibilityConverter}}">
																<Image
																Width="16"
																Height="16"
																Source="Assets/Universal/Main/mood.png" />
																<TextBlock
																Margin="9,0,0,0"
																
																
																Text="{Binding Partner.Status, TargetNullValue=''}"
																TextTrimming="CharacterEllipsis" />
															</StackPanel>
															<!--  Time row for remote user. TODO: implement this in Yggdrasil  -->
															<StackPanel
															x:Name="TimeRow"
															Margin="0,0,0,15"
															HorizontalAlignment="Left"
															Orientation="Horizontal"
															IsVisible="False">
																<Image
																Width="16"
																Height="16"
																Source="Assets/Universal/Main/clock.png" />
																<TextBlock
																Margin="9,0,0,0"
																
																
																Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat={}{0:h:mm tt}}"
																TextTrimming="CharacterEllipsis" />
															</StackPanel>
															<!--  Connection status row (online, offline, away, dnd)  -->
															<StackPanel
															x:Name="StatusRow"
															HorizontalAlignment="Left"
															Orientation="Horizontal">
																<global:SliceControl
																Width="14"
																Height="14"
																DefaultIndex="{Binding Partner.ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
																ElementCount="22"
																Interactive="False"
																SliceMode="0"
																Source="Assets/Universal/Icon/skype-status-small.png"
																StackDirection="Horizontal" />
																<TextBlock
																Margin="11,0,0,0"
																
																
																Text="{Binding Partner.ConnectionStatus, Converter={StaticResource StatIntToText}}"
																TextTrimming="CharacterEllipsis" />
															</StackPanel>
														</StackPanel>
													</Grid>
												</DataTemplate>
												<DataTemplate DataType="{x:Type yggdrasil:Group}">
													<ItemsControl ItemsSource="{Binding Members}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel
																HorizontalAlignment="Center"
																VerticalAlignment="Center"
																Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate DataType="{x:Type yggdrasil:User}">
																<StackPanel
																Width="120"
																Margin="10,0"
																Orientation="Vertical">
																	<!--  Name row with status icon  -->
																	<StackPanel
																	Margin="0,0,0,2"
																	HorizontalAlignment="Center"
																	Orientation="Horizontal">
																		<global:SliceControl
																		Width="16"
																		Height="16"
																		VerticalAlignment="Center"
																		DefaultIndex="{Binding ConnectionStatus, Converter={StaticResource ConnectionStatusConverter}}"
																		ElementCount="22"
																		Interactive="False"
																		SliceMode="0"
																		Source="Assets/Universal/Icon/skype-status.png"
																		StackDirection="Horizontal" />
																		<TextBlock
																		MaxWidth="100"
																		Margin="5,0,0,1"
																		VerticalAlignment="Center"
																		
																		
																		Foreground="{DynamicResource Text.VeryHighContrast}"
																		Text="{Binding DisplayName}"
																		TextTrimming="CharacterEllipsis"
																		TextWrapping="NoWrap" />
																	</StackPanel>
																	<!--  Profile picture  -->
																	<Image
																	Width="85"
																	Margin="0,3,0,0"
																	Stretch="UniformToFill">
																		<Image.Source>
																			<MultiBinding Converter="{StaticResource AvatarConverter}">
																				<Binding Path="Avatar" />
																				<Binding Source="user" />
																			</MultiBinding>
																		</Image.Source>
																		<Image.Effect>
																			<DropShadowEffect
																			BlurRadius="4"
																			OffsetX="0" OffsetY="1"

																			Color="{DynamicResource Avatar.Shadow}" />
																		</Image.Effect>
																	</Image>
																</StackPanel>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</DataTemplate>
												<DataTemplate DataType="{x:Type yggdrasil:Server}">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<!--  Profile picture column  -->
														<Image
														x:Name="CPAProfilePic"
														Grid.Column="0"
														Margin="4,4,5,9"
														HorizontalAlignment="Left"
														VerticalAlignment="Top"
														Stretch="UniformToFill">
															<Image.Source>
																<MultiBinding Converter="{StaticResource AvatarConverter}">
																	<Binding Path="Avatar" />
																	<Binding Source="group" />
																</MultiBinding>
															</Image.Source>
															<Image.Effect>
																<DropShadowEffect
																BlurRadius="4"
																OffsetX="0" OffsetY="1"

																Color="{DynamicResource Avatar.Shadow}" />
															</Image.Effect>
														</Image>
														<!--  Information column  -->
														<StackPanel
														Grid.Column="1"
														Margin="12,12"
														Orientation="Vertical">
															<!--  Server channel count row  -->
															<StackPanel
															x:Name="StatusRow"
															HorizontalAlignment="Left"
															Orientation="Horizontal">
																<global:SliceControl
																Width="14"
																Height="14"
																DefaultIndex="2"
																ElementCount="11"
																Interactive="False"
																SliceMode="0"
																Source="Assets/Universal/Icon/skype-channel.png"
																StackDirection="Horizontal" />
																<TextBlock
																Margin="11,0,0,0"
																
																
																Text="{Binding Channels.Count, StringFormat='{}Server - {0} channels'}"
																TextTrimming="CharacterEllipsis" />
															</StackPanel>
														</StackPanel>
													</Grid>
												</DataTemplate>
												<DataTemplate DataType="{x:Type yggdrasil:ServerChannel}">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" />
															<ColumnDefinition Width="*" />
														</Grid.ColumnDefinitions>
														<!--  Profile picture column  -->
														<Image
														x:Name="CPAProfilePic"
														Grid.Column="0"
														Margin="4,4,5,9"
														HorizontalAlignment="Left"
														VerticalAlignment="Top"
														Stretch="UniformToFill">
															<Image.Source>
																<MultiBinding Converter="{StaticResource AvatarConverter}">
																	<Binding Path="Avatar" />
																	<Binding Source="group" />
																</MultiBinding>
															</Image.Source>
															<Image.Effect>
																<DropShadowEffect
																BlurRadius="4"
																OffsetX="0" OffsetY="1"

																Color="{DynamicResource Avatar.Shadow}" />
															</Image.Effect>
														</Image>
														<!--  Information column  -->
														<StackPanel
														Grid.Column="1"
														Margin="12,12"
														Orientation="Vertical">
															<!--  Server channel descriptor row  -->
															<StackPanel
															x:Name="StatusRow"
															HorizontalAlignment="Left"
															Orientation="Horizontal">
																<global:SliceControl
																Width="14"
																Height="14"
																DefaultIndex="{Binding ChannelType, Converter={StaticResource ChannelTypeConverter}}"
																ElementCount="11"
																Interactive="False"
																SliceMode="0"
																Source="Assets/Universal/Icon/skype-channel.png"
																StackDirection="Horizontal" />
																<TextBlock
																Margin="11,0,0,0"
																
																
																Text="Server channel"
																TextTrimming="CharacterEllipsis" />
															</StackPanel>
														</StackPanel>
													</Grid>
												</DataTemplate>
											</ContentControl.DataTemplates>
										</ContentControl>
									</Grid>
								</Border>
								<Rectangle
								x:Name="ChatTopBarSplitter"
								Grid.Row="2"
								Cursor="SizeNorthSouth"
								Fill="Transparent"
								PointerPressed="ChatTopBarSplitter_Press"
								PointerMoved="ChatTopBarSplitter_PointerMoved" />
								<Border
								x:Name="MessageWindow"
								Grid.Row="3"
								Background="{DynamicResource Card.Background}"
								BorderBrush="{DynamicResource Card.Border}"
								BorderThickness="1,1,1,1"
								CornerRadius="4,4,4,4">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition  Height="34" />
											<RowDefinition Height="1" />
											<RowDefinition Height="*" />
											<RowDefinition Height="20" />
											<RowDefinition Height="Auto" />
										</Grid.RowDefinitions>
										<StackPanel
										Grid.Row="0"
										Margin="7,1,0,0"
										HorizontalAlignment="Left"
										Orientation="Horizontal">
											<global:SliceControl
											x:Name="VideoCallButton"
											Width="NaN"
											Margin="0,0,10,0"
											Command="{Binding DataContext.VideoCallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
											DefaultIndex="0"
											ElementCount="5"
											HoverIndex="1"
											IsEnabled="False"
											LeftWidth="22"
											PressedIndex="2"
											RightWidth="22"
											Source="Assets/Universal/Main/btn_video_call.png"
											StackDirection="Vertical"
											Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_STARTVIDEOCALL]}"
											TextColor="White"
											TextFont="Arial"
											TextLeftMargin="25"
											TextRightMargin="9"
											TextSize="13"
											TextWeight="Bold" />
											<!--  TODO change event to something like Command="{Binding DataContext.CallCommand, RelativeSource={RelativeSource AncestorType=Window}}"  -->
											<global:SliceControl
											x:Name="CallButton"
											Width="NaN"
											DefaultIndex="0"
											ElementCount="5"
											HoverIndex="1"
											LeftWidth="23"
											PointerReleased="CallButtonClick"
											PressedIndex="2"
											RightWidth="4"
											Source="Assets/Universal/Main/btn_call_left.png"
											StackDirection="Vertical"
											Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_CALL]}"
											TextColor="White"
											TextFont="Arial"
											TextLeftMargin="26"
											TextSize="13"
											TextWeight="Bold" />
											<global:SliceControl
											x:Name="CallDropdown"
											Width="24"
											Margin="0,0,10,0"
											DefaultIndex="0"
											ElementCount="5"
											HoverIndex="1"
											LeftWidth="1"
											PressedIndex="2"
											RightWidth="1"
											Source="Assets/Universal/Main/btn_call_right.png"
											StackDirection="Vertical" />
											<global:SliceControl
											Width="44"
											DefaultIndex="0"
											ElementCount="5"
											HoverIndex="1"
											PointerReleased="AddButtonClick"
											PressedIndex="2"
											SliceMode="0"
											Source="Assets/Themeable/Main/add.png"
											StackDirection="Vertical"
											Themeable="True" />
											<global:SliceControl
											x:Name="WifiButton"
											Width="44"
											Margin="10,0,0,0"
											Command="{Binding DataContext.RunSpeedTestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
											DefaultIndex="0"
											ElementCount="5"
											HoverIndex="1"
											PressedIndex="2"
											SliceMode="0"
											Source="Assets/Themeable/Main/network-none.png"
											StackDirection="Vertical"
											Themeable="True" />
										</StackPanel>
										<Rectangle
										Grid.Row="1"
										Height="1"
										Fill="{DynamicResource Chatbar.Divider}" />
										<Image
										x:Name="Spinner"
										Grid.Row="2"
										Width="90"
										Height="90"
										RenderTransformOrigin="0.5,0.5"
										Source="Assets/Universal/Animations/spinner.png"
										IsVisible="True">
										</Image>
										<ListBox
										x:Name="ConversationItemsList"
										Grid.Row="2"
										Margin="0,0,0,0"
										VerticalAlignment="Bottom"
										BorderThickness="0"
										Loaded="ConversationItemsList_Loaded"
										ScrollViewer.HorizontalScrollBarVisibility="Disabled"
										Theme="{StaticResource NoInsetListBox}"										mc:Ignorable="d">
											<ListBox.ItemsPanel>
												<ItemsPanelTemplate>
													<VirtualizingStackPanel />
												</ItemsPanelTemplate>
											</ListBox.ItemsPanel>
											<ListBox.Styles>
												<Style Selector="ListBoxItem">
													<Setter Property="HorizontalAlignment" Value="Stretch" />
													<Setter Property="Padding" Value="0" />
													<Setter Property="Template">
														<Setter.Value>
<ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="ItemBorder"
            Background="{Binding IsSelected,
                RelativeSource={RelativeSource TemplatedParent},
                Converter={StaticResource SelectedToSelectionBrush}}">
        <ContentPresenter Name="PART_ContentPresenter"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
</ControlTemplate>
														</Setter.Value>
													</Setter>
												</Style>
											</ListBox.Styles>
										</ListBox>
										<Grid
										Grid.Row="4"
										Margin="0,0,0,5"
										VerticalAlignment="Bottom">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<global:SliceControl
											Grid.Column="1"
											BottomHeight="4"
											DefaultIndex="0"
											ElementCount="7"
											SliceMode="2"
											Source="Assets/Themeable/Main/message-box-header25.png"
											StackDirection="Vertical"
											Themeable="True"
											TopHeight="25" />
											<StackPanel
											x:Name="MessageBoxPanel"
											Grid.Column="1"
											Width="429"
											HorizontalAlignment="Center"
											Orientation="Vertical">
												<!--  Message box header  -->
												<Grid Height="25">
													<StackPanel
													Margin="5,0,0,0"
													VerticalAlignment="Center"
													Orientation="Horizontal">
														<global:SliceControl
														x:Name="EmojiButton"
														Width="18"
														Height="18"
														HorizontalAlignment="Left"
														DefaultIndex="0"
														ElementCount="5"
														HoverIndex="1"
														PointerReleased="EmojiButton_Click"
														PressedIndex="2"
														SliceMode="0"
														Source="Assets/Themeable/Main/emoji.png"
														StackDirection="Vertical"
														Themeable="True" />
													</StackPanel>
													<Popup
													x:Name="EmojiFlyout"
													
													HorizontalOffset="-20"
													Placement="Top"
													PlacementTarget="{Binding ElementName=EmojiButton}"
													IsLightDismissEnabled="True">
														<Border
														Padding="2"
														Background="{DynamicResource EmojiFlyout.Background}"
														BorderBrush="{DynamicResource EmojiFlyout.Border}"
														BorderThickness="1"
														CornerRadius="4">
															<ScrollViewer
															MaxWidth="257"
															MaxHeight="278"
															HorizontalScrollBarVisibility="Disabled"
															VerticalScrollBarVisibility="Visible">
																<ScrollViewer.Styles>
																	<Style Selector="ScrollBar">
																		<Setter Property="Width" Value="8" />
																		<Setter Property="Background" Value="Transparent" />
																	</Style>
																</ScrollViewer.Styles>
																<WrapPanel x:Name="EmojiWrapPanel" Orientation="Horizontal" />
															</ScrollViewer>
														</Border>
													</Popup>
													<StackPanel
													x:Name="TypingIndicator"
													Margin="0,0,7,0"
													HorizontalAlignment="Right"
													Orientation="Horizontal"
													IsVisible="False">
														<global:SliceControl
														x:Name="TypingIndicatorIcon"
														Width="23"
														AnimationFps="30"
														DefaultIndex="0"
														ElementCount="37"
														HoverIndex="-1"
														IsAnimation="True"
														PressedIndex="-1"
														SliceMode="0"
														Source="Assets/Universal/Main/pencil-write.png"
														StackDirection="Vertical" />
														<TextBlock
														x:Name="TypingIndicatorText"
														Margin="3,0,0,0"
														VerticalAlignment="Center"
														Foreground="{DynamicResource Text.MediumContrast}" />
													</StackPanel>
												</Grid>
												<!--  Message box typing area  -->
<TextBox
    x:Name="MessageTextBox"
    MinHeight="35"
    MaxHeight="{Binding Bounds.Height, ElementName=MessageWindow, Converter={StaticResource HalfValueConverter}}"
    Padding="2,3"
    AcceptsReturn="True"
    Background="Transparent"
    BorderThickness="0"
    
    
    GotFocus="MessageTextBox_Focused"
    LostFocus="MessageTextBox_Unfocused"
    TextChanged="MessageTextBox_TextChanged"
    UseLayoutRounding="True"
    ScrollViewer.VerticalScrollBarVisibility="Auto"
    TextWrapping="Wrap" />
											</StackPanel>
											<global:SliceControl
											x:Name="SendMsgButton"
											Grid.Column="2"
											Width="NaN"
											Margin="8,0,0,0"
											HorizontalAlignment="Left"
											VerticalAlignment="Top"
											DefaultIndex="0"
											ElementCount="5"
											Focusable="False"
											HoverIndex="1"
											IsEnabled="False"
											LeftWidth="22"
											PointerReleased="OnMsgSendClickButton"
											PressedIndex="2"
											RightWidth="22"
											Source="Assets/Universal/Main/msg-send-button-full.png"
											StackDirection="Vertical"
											Text="{Binding Source={StaticResource Lang}, Path=[sZAPBUTTON_SENDMESSAGE]}"
											TextColor="White"
											TextFont="Arial"
											TextLeftMargin="26"
											TextSize="13"
											TextWeight="Bold" />
										</Grid>
									</Grid>
								</Border>
							</Grid>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</theming:MainWindowBase>


