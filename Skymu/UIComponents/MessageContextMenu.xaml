<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skymu.Converters"
    xmlns:global="clr-namespace:Skymu">
    <converters:IsCurrentUserToVisibilityConverter x:Key="IsCurrentUserToVisibilityConverter" />
    <ContextMenu x:Key="MessageContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <!--  Copy selected  -->
        <MenuItem Header="{Binding Path=PlacementTarget.Tag[sF_CHAT_FORM_IMGRID_PMENUITEM_COPY], RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
        <!--  Copy message  -->
        <MenuItem
            Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=CopyMessageCommand}"
            CommandParameter="{Binding}"
            Header="{Binding Path=PlacementTarget.Tag[sCHAT_MENU_COPY_MESSAGE], RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        <!--  Select all  -->
        <MenuItem Header="{Binding Path=PlacementTarget.Tag[sF_CHAT_FORM_IMGRID_PMENUITEM_SELALL], RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="False" />
        <Separator />
        <!--  Reply  -->
        <MenuItem
            Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=ReplyToMessageCommand}"
            CommandParameter="{Binding}"
            Header="Reply" />
        <!--  Edit  -->
        <MenuItem
            Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=EditMessageCommand}"
            CommandParameter="{Binding}"
            Header="{Binding Path=PlacementTarget.Tag[sCHAT_EDIT_MESSAGE], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Visibility="{Binding Author.Identifier, Converter={StaticResource IsCurrentUserToVisibilityConverter}}" />
        <!--  Delete  -->
        <MenuItem
            Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=DeleteMessageCommand}"
            CommandParameter="{Binding}"
            Header="{Binding Path=PlacementTarget.Tag[sCHAT_MENU_REMOVE_MESSAGE], RelativeSource={RelativeSource AncestorType=ContextMenu}}"
            Visibility="{Binding Author.Identifier, Converter={StaticResource IsCurrentUserToVisibilityConverter}}" />
        <!--  Move bookmark  -->
        <MenuItem
            Command="{Binding Source={x:Static global:Universal.ActiveViewModel}, Path=MoveBookmarkCommand}"
            CommandParameter="{Binding}"
            Header="{Binding Path=PlacementTarget.Tag[sCHAT_MENU_MOVE_BOOKMARK], RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    </ContextMenu>
</ResourceDictionary>