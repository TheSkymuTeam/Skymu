<Window
    x:Class="Skymu.Forms.Options"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skymu.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="clr-namespace:Skymu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preferences="clr-namespace:Skymu.Preferences"
    xmlns:theming="clr-namespace:Skymu.Theming"
    xmlns:controls="clr-namespace:Skymu.Controls"
    Width="716"
    Height="612"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Background="#d4e2f2"
    DataContext="{StaticResource Lang}"
    
    
    CanMinimize="True"
    
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Title>
        <MultiBinding StringFormat="{}{0}™ {1}">
            <Binding Path="[sMAINMENU_SKYPE]" Source="{StaticResource Lang}" />
            <Binding Path="[sF_OPTIONS_CAPTION]" Source="{StaticResource Lang}" />
        </MultiBinding>
    </Window.Title>

    <Window.Resources>
        <converters:AssetLoader x:Key="AssetLoader" />
    </Window.Resources>

    <Window.Styles>
		<Style Selector="controls|SliceControl.sidebarHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ElementCount" Value="5" />
            <Setter Property="DefaultIndex" Value="0" />
            <Setter Property="HoverIndex" Value="1" />
            <Setter Property="PressedIndex" Value="2" />
            <Setter Property="Source" Value="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Themeable/Options/header_background.png}" />
            <Setter Property="Themeable" Value="True" />
            <Setter Property="IconLeftMargin" Value="10" />
            <Setter Property="IconWidth" Value="24" />
            <Setter Property="IconHeight" Value="24" />
            <Setter Property="IsRadioButton" Value="True" />
            <Setter Property="PressedOffsetY" Value="0" />
            <Setter Property="TextColor" Value="{DynamicResource Text.MediumContrast}" />
            <Setter Property="TextFont" Value="Tahoma" />
            <Setter Property="TextLeftMargin" Value="39" />
            <Setter Property="TextSize" Value="11" />
        </Style>
        <Style Selector="controls|SliceControl.sidebarItemContainer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SliceControl">
                        <controls:SliceControl
                            VerticalAlignment="Stretch"
                            BottomHeight="2"
                            DefaultIndex="4"
                            ElementCount="5"
                            ElementSpan="1"
                            HoverIndex="-1"
                            Interactive="False"
                            PressedIndex="-1"
                            SliceMode="2"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Themeable/Options/header_background.png}"
                            StackDirection="Vertical"
                            Themeable="True"
                            TopHeight="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="controls|SliceControl.sidebarButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="IsRadioButton" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SliceControl">
                        <Grid Height="40">
                            <controls:SliceControl
                                x:Name="InnerSlice"
                                Margin="4,-1,4,2"
                                Background="#ffffff"
                                BackgroundPressed="{DynamicResource Settings.ActiveTab}"
                                IsRadioButton="True"
                                PointerPressed="TabSelect"
                                PressedOffsetY="0"
                                Tag="{Binding RelativeSource={RelativeSource AncestorType=controls:SliceControl}}"
                                Text="{TemplateBinding Text}"
                                TextColor="{DynamicResource Text.MediumContrast}"
                                TextColorPressed="{DynamicResource Settings.ActiveTabText}"
                                TextFont="Tahoma"
                                TextLeftMargin="39"
                                TextSize="11" />
                            <Image
                                Height="24"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Source="{TemplateBinding Source}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Styles>

    <Border BorderThickness="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="182" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                <!--  TODO: only use SidebarItmeContainer or SidebarHeader  -->
                <controls:SliceControl
                    x:Name="HGeneral"
                    ButtonStateOnInit="Pressed"
                    DefaultIndex="3"
                    HoverIndex="-1"
                    IconHeight="24"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/general.png}"
                    PointerReleased="CatSelect"
                    PressedIndex="-1"
                    Classes="sidebarHeader"
                    Text="{Binding [sF_OPTIONS_PAGE_GENERAL]}" />
                <Grid x:Name="GGeneral">
                    <controls:SliceControl Classes="sidebarItemContainer" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,1"
                        Orientation="Vertical">
                        <controls:SliceControl
                            x:Name="General_Main"
                            ButtonStateOnInit="Pressed"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/skype.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_GENERAL]}" />
                        <controls:SliceControl
                            x:Name="General_Devices"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/audio.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_DEVICES]}" />
                        <controls:SliceControl
                            x:Name="General_Sounds"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/sounds.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_SOUNDS2]}" />
                        <controls:SliceControl
                            x:Name="General_Video"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/video.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_VIDEO]}" />
                        <controls:SliceControl
                            x:Name="General_Access"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/access.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_SKYACCESS]}" />
                        <!--  Skymu original  -->
                        <controls:SliceControl
                            x:Name="General_Skymu"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/skymu.png}"
                            Classes="sidebarButton"
                            Text="Skymu" />
                    </StackPanel>
                </Grid>
                <controls:SliceControl
                    x:Name="HPrivacy"
                    IconHeight="24"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/privacy.png}"
                    PointerReleased="CatSelect"
                    Classes="sidebarHeader"
                    Text="{Binding [sF_OPTIONS_PAGE_PRIVACY]}" />
                <Grid x:Name="GPrivacy" IsVisible="False">
                    <controls:SliceControl Classes="sidebarItemContainer" />
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <controls:SliceControl
                            x:Name="Privacy_Main"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/privacy_settings.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PRIVACY_SETTINGS]}" />
                        <controls:SliceControl
                            x:Name="Privacy_Blocked"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/blocked.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_BLOCKED_USERS]}" />
                    </StackPanel>
                </Grid>
                <controls:SliceControl
                    x:Name="HNotifications"
                    IconHeight="24"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/notifications.png}"
                    PointerReleased="CatSelect"
                    Classes="sidebarHeader"
                    Text="{Binding [sF_OPTIONS_PAGE_NOTIFICATIONS]}" />
                <Grid x:Name="GNotifications" IsVisible="False">
                    <controls:SliceControl Classes="sidebarItemContainer" />
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <controls:SliceControl
                            x:Name="Notifications_Main"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/notifications.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_LBC_NOTIFICATIONS]}" />
                        <controls:SliceControl
                            x:Name="Notifications_Alerts"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/alerts.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_LBC_MESSAGES]}" />
                        <controls:SliceControl
                            x:Name="Notifications_Sounds"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/sounds.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_SOUNDS2]}" />
                    </StackPanel>
                </Grid>
                <controls:SliceControl
                    x:Name="HCalls"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/calls.png}"
                    PointerReleased="CatSelect"
                    Classes="sidebarHeader"
                    Text="{Binding [sF_OPTIONS_CALLS]}" />
                <Grid x:Name="GCalls" IsVisible="False">
                    <controls:SliceControl Classes="sidebarItemContainer" />
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <controls:SliceControl
                            x:Name="Calls_Main"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/calls.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_LB_CALL]}" />
                        <controls:SliceControl
                            x:Name="Calls_Forwarding"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/forwarding.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_FORWARDINGANDVOICEMAIL]}" />
                        <controls:SliceControl
                            x:Name="Calls_Voicemail"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/voicemail.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_LBC_VOICEMAIL]}" />
                        <controls:SliceControl
                            x:Name="Calls_Video"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/video.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_VIDEO]}" />
                    </StackPanel>
                </Grid>
                <controls:SliceControl
                    x:Name="HChatsSMS"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/im_and_sms.png}"
                    PointerReleased="CatSelect"
                    Classes="sidebarHeader"
                    Text="{Binding [sF_OPTIONS_CHATS_SMS]}" />
                <Grid x:Name="GChatsSMS" IsVisible="False">
                    <controls:SliceControl Classes="sidebarItemContainer" />
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <controls:SliceControl
                            x:Name="Chats_Main"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/im.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_LB_CHAT_SETTINGS]}" />
                        <controls:SliceControl
                            x:Name="Chats_Appearance"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/appearance.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_CHAT_APPEARANCE]}" />
                        <controls:SliceControl
                            x:Name="Chats_SMS"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/sms.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_SMS]}" />
                    </StackPanel>
                </Grid>
                <controls:SliceControl
                    x:Name="HAdvanced"
                    IconSource="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/advanced.png}"
                    PointerReleased="CatSelect"
                    Classes="sidebarHeader"
                    Text="{Binding [sF_OPTIONS_PAGE_DEBUG]}" />
                <Grid x:Name="GAdvanced" IsVisible="False">
                    <controls:SliceControl Classes="sidebarItemContainer" />
                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <controls:SliceControl
                            x:Name="Advanced_Main"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/advanced.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_UPDATES]}" />
                        <!--  holy fuck why Skype  -->
                        <controls:SliceControl
                            x:Name="Advanced_Updates"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/updates.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_UPGRATES]}" />
                        <controls:SliceControl
                            x:Name="Advanced_Connection"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/connection.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_CONNECTION]}" />
                        <controls:SliceControl
                            x:Name="Advanced_Hotkeys"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/hotkeys.png}"
                            Classes="sidebarButton"
                            Text="{Binding [sF_OPTIONS_PAGE_KEYBOARD]}" />
                        <!--  Skymu original  -->
                        <controls:SliceControl
                            x:Name="Advanced_Debug"
                            PointerPressed="TabSelect"
                            Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Universal/Options/advanced.png}"
                            Classes="sidebarButton"
                            Text="Debug"
                            IsVisible="False" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <controls:SliceControl
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BottomHeight="3"
                        DefaultIndex="3"
                        ElementCount="5"
                        ElementSpan="2"
                        Interactive="False"
                        SliceMode="2"
                        Source="{Binding Converter={StaticResource AssetLoader}, Source=Assets/Themeable/Options/header_background.png}"
                        StackDirection="Vertical"
                        Themeable="True"
                        TopHeight="37" />
                    <StackPanel
                        Margin="10,12,0,6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Panel.ZIndex="2"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="CTabTitle"
                            
                            
                            FontWeight="Bold"
                            Foreground="{DynamicResource Text.HighContrast}"
                            Text="Skymu Customization:" />
                        <TextBlock
                            x:Name="CTabDescription"
                            Margin="7,0"
                            
                            
                            Foreground="{DynamicResource Text.HighContrast}"
                            Text="Modify the way Skymu looks, feels, and behaves" />
                    </StackPanel>
                    <ContentControl
                        x:Name="PageHost"
                        Margin="5,40,5,5" />
                </Grid>

                <StackPanel
                    Grid.Row="2"
                    Height="23"
                    Margin="0,10,3,3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,12,0"
                        Padding="12,0"
                        Click="SaveButtonClick"
                        Content="{Binding [sF_OPTIONS_BUTTON_SAVE]}"
                         />
                    <Button
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,12,0"
                        Padding="12,0"
                        Click="RestartButtonClick"
                        Content="Save and restart"
                         />
                    <Button
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,12,0"
                        Padding="12,0"
                        Click="ResetButtonClick"
                        Content="{Binding [sF_OPTIONS_BTN_RESET]}"
                         />
                    <Button
                        Height="23"
                        MinWidth="73"
                        Padding="12,0"
                        Click="CancelButtonClick"
                        Content="{Binding [sF_OPTIONS_BUTTON_CANCEL]}"
                         />
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>