<UserControl
    x:Class="Skymu.Forms.OptionPages.General.Skymu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Skymu.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:Skymu.Enumerations"
    xmlns:global="clr-namespace:Skymu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:preferences="clr-namespace:Skymu.Preferences"
    xmlns:theming="clr-namespace:Skymu.Theming"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    DataContext="{StaticResource Lang}"
    
    
    Foreground="{DynamicResource Text.VeryHighContrast}"
    
    mc:Ignorable="d">
    <!--  Commented out as the page is a scrolling thing  -->
    <!--  Re-add to Page when the view becomes small enough to not require a ScrollViewer  -->
    <!--  d:Height="505"  -->
    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:BoolInverterConverter x:Key="BoolInverterConverter" />
        <converters:StringToIntegerConverter x:Key="StringToIntegerConverter" />
    </UserControl.Resources>

    <ScrollViewer Margin="10">
        <StackPanel Orientation="Vertical">

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Branding name" />
                <TextBox
                    x:Name="SC_BrandingNameBox"
                    Width="250"
                    
                    Text="{Binding Path=[BrandingName], Mode=TwoWay, Source={x:Static preferences:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{Binding [sF_USERINFO_LABEL_LANGUAGE]}" />
<ComboBox
    Width="250"
    ItemsSource="{Binding Languages}"
    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Key}" />
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
            </StackPanel>
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox
                    Padding="6,0"
                    Content="Follow system regional variances (time format, date format, units)"
                    Foreground="{DynamicResource Text.VeryHighContrast}"
                    IsChecked="{Binding Path=[UseSystemCulture], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Text.MediumContrast}"
                    Text="(Requires restart)" />
            </StackPanel>
            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="User interface" />
<ComboBox
    Width="250"
    SelectedValue="{Binding Path=[Theme], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
    SelectedValueBinding="{Binding Tag}">
    <ComboBoxItem
        Padding="6,0"
        Content="Skype 4"
        Tag="Skype4" />
    <ComboBoxItem
        Padding="6,0"
        Content="Skype 5"
        Tag="Skype5" />
    <ComboBoxItem
        Padding="6,0"
        Content="Skype 6"
        Tag="Skype6" />
    <ComboBoxItem
        Padding="6,0"
        Content="Skype 7 (experimental)"
        Tag="Skype7" />
</ComboBox>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Text.MediumContrast}"
                    Text="(Requires restart)" />
            </StackPanel>


            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Window chrome" />
<ComboBox
    Width="250"
    SelectedValue="{Binding Path=[WindowChrome], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
    SelectedValueBinding="{Binding Tag}">

    <ComboBoxItem
        Padding="6,0"
        Content="Skype Aero"
        Tag="{x:Static enums:WindowChrome.SkypeAero}" />

    <ComboBoxItem
        Padding="6,0"
        Content="Skype XP"
        Tag="{x:Static enums:WindowChrome.SkypeXP}" />

        <ComboBoxItem
        Padding="6,0"
        Content="Skype Aero with acrylic blur"
        Tag="{x:Static enums:WindowChrome.Acrylic}" />

    <ComboBoxItem
        Padding="6,0"
        Content="Use the system window chrome"
        Tag="{x:Static enums:WindowChrome.Native}" />
</ComboBox>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Text.MediumContrast}"
                    Text="(Requires restart)" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Color theme" />
<ComboBox
    Width="250"
    ItemsSource="{x:Static theming:Colorizer.Colorways}"
    SelectedValue="{Binding Path=[Colorway], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
    SelectedValueBinding="{Binding Key}">
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Key}" />
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Text.MediumContrast}"
                    Text="(Requires restart)" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Sound pack" />
<ComboBox
    x:Name="ComboSoundPack"
    Width="250"
    SelectedValue="{Binding Path=[SoundPack], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
    SelectedValueBinding="{Binding Tag}">

    <ComboBoxItem
        Padding="6,0"
        Content="Enhanced"
        Tag="{x:Static enums:Soundpack.Enhanced}" />

    <ComboBoxItem
        Padding="6,0"
        Content="Skype 1 and 2"
        Tag="{x:Static enums:Soundpack.Skype2}" />

    <ComboBoxItem
        Padding="6,0"
        Content="Skype 3 to 7"
        Tag="{x:Static enums:Soundpack.Skype7}" />

    <ComboBoxItem
        Padding="6,0"
        Content="Skype 8"
        Tag="{x:Static enums:Soundpack.Skype8}" />
</ComboBox>
            </StackPanel>
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Base theme (scrollbar, buttons, etc)" />
<ComboBox
    Width="250"
    SelectedValue="{Binding Path=[AvaloniaTheme], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
    SelectedValueBinding="{Binding Tag}">
                <ComboBoxItem
        Padding="6,0"
        Content="Draw native-styled controls (recommended)"
        Tag="Native" />
        <ComboBoxItem
        Padding="6,0"
        Content="Avalonia Fluent"
        Tag="Avalonia.Fluent.Dynamic" />
    <ComboBoxItem
        Padding="6,0"
        Content="Avalonia Simple"
        Tag="Avalonia.Simple" />
    <ComboBoxItem
        Padding="6,0"
        Content="Classic.Avalonia"
        Tag="Classic.Avalonia" />
</ComboBox>
            </StackPanel>

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Use a sky-blue background color instead of the dynamic colors on Skype 4 and 5"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[FallbackFillColors], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Use the unreleased 'room-style' call UI from the mid-2012 Skype 5.5 mockups"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[RoomCallUI], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Use the call reconnecting sound instead of the outgoing call sound when placing a call"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[CallOutToReconnectSound], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Replace all dialog icons with 'Niko' from the game 'Oneshot'"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[NikoIcons], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="{Binding [s_OPTIONS_WATERMARK]}"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[Watermark], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Remember positioning (window size, location, sidebar size)"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[SaveWindowPosition], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />



            <StackPanel Margin="0,5,0,5" Grid.IsSharedSizeScope="True">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SidebarRadioCol" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SidebarLabelCol" />
                    </Grid.ColumnDefinitions>

                    <RadioButton
                        x:Name="StaticSidebarTabsRadio"
                        Grid.Column="0"
                        Margin="0,3,0,0"
                        VerticalAlignment="Top"
                        Checked="StaticSidebarTabsRadio_Checked"
                        GroupName="SidebarTabSizeModeGroup" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,1,10,0"
                        VerticalAlignment="Center">
                        <TextBlock Text="Static sidebar tabs: do not resize tab width based on selection state" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SidebarRadioCol" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="SidebarLabelCol" />
                    </Grid.ColumnDefinitions>

                    <RadioButton
                        x:Name="DynamicSidebarTabsRadio"
                        Grid.Column="0"
                        Margin="0,3,0,0"
                        VerticalAlignment="Top"
                        Checked="DynamicSidebarTabsRadio_Checked"
                        GroupName="SidebarTabSizeModeGroup" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="5,1,10,0"
                        VerticalAlignment="Center">
                        <TextBlock Text="Accurate sidebar tabs: dynamically resize width based on selection state" />
                    </StackPanel>
                </Grid>

            </StackPanel>

            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Check for updates to Skymu (highly recommended to keep this enabled!)"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[CheckUpdates], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Save credentials to file (credentials.xml)"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[SaveCredentials], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Enable automatic login if credentials are saved"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[AutoLogin], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />



            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Amount of messages to fetch during initial conversation load" />
                <TextBox
                    Width="40"
                    
                    Text="{Binding [MsgLoadCount], Converter={StaticResource StringToIntegerConverter}, Mode=TwoWay, Source={x:Static preferences:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Start with the window minimized"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[StartMinimized], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Allow multiple instances of the application to run at the same time (disabling this is experimental)"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[AllowMultipleInstances], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Run the speed test on each startup (uses 10 MB of bandwidth for no real benefit)"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[CheckSpeedOnStartup], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="{Binding [sF_USERENTRY_CB_START_SKYPE]}"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[AutoLaunch], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Retain original versions of edited and deleted messages"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[MessageLogger], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Inform me when a new beta update is available, in addition to new stable updates"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[AllowBetaBuildUpdates], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />


            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Amount of Skype Credit (visual only)" />
                <TextBox
                    Width="80"
                    
                    Text="{Binding Path=[CredsText], Mode=TwoWay, Source={x:Static preferences:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Amount of Skype subscriptions (visual only)" />
                <TextBox
                    Width="40"
                    
                    Text="{Binding [CredsSubCount], Converter={StaticResource StringToIntegerConverter}, Mode=TwoWay, Source={x:Static preferences:Settings.Default}, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />


            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Enable notifications"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[EnableNotifications], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <TextBlock
                    Padding="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="Display a notification for" />
<ComboBox
    Width="250"
    SelectedValue="{Binding Path=[NotificationTrigger], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}"
    SelectedValueBinding="{Binding Tag}">
    <ComboBoxItem
        Padding="6,0"
        Content="all recieved messages"
        Tag="{x:Static enums:NotificationTriggerType.ALL}" />
    <ComboBoxItem
        Padding="6,0"
        Content="direct messages, replies, and pings"
        Tag="{x:Static enums:NotificationTriggerType.PDM}" />
    <ComboBoxItem
        Padding="6,0"
        Content="replies and pings"
        Tag="{x:Static enums:NotificationTriggerType.PING}" />
    <ComboBoxItem
        Padding="6,0"
        Content="direct messages"
        Tag="{x:Static enums:NotificationTriggerType.DM}" />
</ComboBox>
            </StackPanel>
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Allow implicit nick mentions to trigger a notification (supported protocols only)"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[AllowImplicitMentions], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />
            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Force active notifications to be blue instead of the accurate orange"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[BlueNotifications], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />

            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Do not display community ads while using Skymu Home"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[EnableAdBlock], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />


            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />


            <CheckBox
                Margin="0,5"
                Padding="6,0"
                Content="Anonymize my username and display name in Skymu's connected user statistics"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[Anonymize], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}" />

            <CheckBox
                MaxWidth="450"
                Margin="0,5"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource Text.VeryHighContrast}"
                IsChecked="{Binding Path=[DisableSWS], Mode=TwoWay, Source={x:Static preferences:Settings.Default}}">
                <TextBlock Margin="2,0" TextWrapping="Wrap"><Run Text="Disable Skymu Web Services (warning: not recommended, doing this breaks features in the Skymu client!)" /></TextBlock>
            </CheckBox>

            <Rectangle
                Height="1"
                Margin="0,10,10,10"
                Fill="{DynamicResource Card.Border}" />

            

        </StackPanel>
    </ScrollViewer>
</UserControl>
