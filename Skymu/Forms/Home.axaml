<UserControl
    x:Class="Skymu.Forms.Home"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:forms="clr-namespace:Skymu.Forms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="504"
    d:DesignWidth="1116"
    mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Button.pill">

        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource Home.Column.Background}" ColumnDefinitions="649,*">

        <Grid Grid.Column="0" Background="White" RowDefinitions="49,Auto,*">

            <Border Grid.Row="0" Background="{DynamicResource Home.Banner.Background}" BorderBrush="{DynamicResource Sidebar.Header}" BorderThickness="0,0,0,1">
                <Grid Margin="16,2,16,0">
                    <TextBlock
                        x:Name="LearnHeader"
                        VerticalAlignment="Center"
                        FontFamily="Helvetica, Arial"
                        FontSize="18"
                        Foreground="{DynamicResource Text.HighContrast}"
                        Text="Learn how to use Skype" />
                    <Button
                        x:Name="HelpVideosButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Classes="pill"
                        Click="HelpVideosButton_Click"
                        Content="View help videos" />
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                BorderBrush="{DynamicResource Home.AlertsContainer.Border}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource Home.ContactsArea.Background}">

                <StackPanel Margin="16,19,16,0">

                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Helvetica, Arial"
                            FontSize="18"
                            Foreground="{DynamicResource Text.HighContrast}"
                            Text="News and alerts" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                x:Name="ToggleContactsButton"
                                Classes="pill"
                                Click="ToggleContactsButton_Click"
                                Content="Show top contacts" />
                            <Button
                                x:Name="SettingsButton"
                                Width="16"
                                Height="16"
                                Padding="0"
                                Classes="pill"
                                Click="SettingsButton_Click"
                                CornerRadius="8"
                                Content="Configure" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*">
                        <Border
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            VerticalAlignment="Top"
                            Background="{DynamicResource Home.Column.Background}"   
                            BorderBrush="{DynamicResource Avatar.Shadow}"   
                            BorderThickness="1">
                            <Image x:Name="MyAvatar" Stretch="UniformToFill" />
                        </Border>
                        <TextBox
                            x:Name="MoodBox"
                            Grid.Column="1"
                            Height="50"
                            Margin="10,0,0,0"
                            Padding="8,6"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="False"
                            Background="White"
                            BorderBrush="#9DB7C9"
                            BorderThickness="1"
                            CornerRadius="3"
                            FontFamily="Helvetica, Arial"
                            FontSize="12"
                            Foreground="#333"
                            KeyDown="MoodBox_KeyDown"
                            MaxLength="1000"
                            TextWrapping="Wrap"
                            Watermark="Update your mood message" />
                    </Grid>

                    <StackPanel x:Name="TopContactsPanel" Margin="0,32,0,0">
                        <TextBlock
                            FontFamily="Helvetica, Arial"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource Text.HighContrast}"
                            Text="Top contacts" />

                        <ItemsControl
                            x:Name="TopContactsList"
                            Width="650"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="forms:TopContactItem">
                                    <Border
                                        Height="135"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Tapped="Contact_Tapped">
                                        <StackPanel HorizontalAlignment="Left">
                                            <Border
                                                Width="98"
                                                Height="98"
                                                Background="#BBB"
                                                BorderBrush="#C4CDD4"
                                                BorderThickness="1"
                                                BoxShadow="0 1 2 0 #40000000">
                                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock
                                                Width="96"
                                                Margin="0,6,0,0"
                                                FontFamily="Helvetica, Arial"
                                                FontSize="12"
                                                Foreground="#333"
                                                Text="{Binding Name}"
                                                TextAlignment="Center"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="2" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource Home.AlertsContainer.Border}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    x:Name="NoNewsText"
                    Margin="16,24,16,22"
                    FontFamily="Helvetica, Arial"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Text.LowContrast}"
                    Text="No news or alerts yet." />
            </Border>
        </Grid>

        <!-- ================= Right gutter TODO add advertisements! ================= -->
        <Border
            Grid.Column="1"
            BorderBrush="#D0D0D0"
            BorderThickness="1,0,0,0" />
    </Grid>
</UserControl>
