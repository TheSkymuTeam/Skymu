<UserControl
    x:Class="Skymu.Forms.Pages.Updater"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Skymu.Forms.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    
    
    Foreground="{DynamicResource Text.VeryHighContrast}"
    >
    <StackPanel
        Height="210"
        VerticalAlignment="Top"
        Orientation="Vertical">
        <ScrollViewer
            MaxHeight="210"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <TextBlock
                Name="Description"
                VerticalAlignment="Stretch"
                LineHeight="16"
                Text="There's a new version of Skype available. Update now to get the latest features and improvements."
                TextWrapping="Wrap" />
        </ScrollViewer>
        <Grid
            Name="ProgressGrid"
            Width="370"
            Margin="0,30,0,0"
            HorizontalAlignment="Left"
            IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Name="UpdateStatusText"
                Grid.Row="0"
                
                
                Text="Update progress goes here" />
            <ProgressBar
                x:Name="ProgBar"
                Grid.Row="1"
                Height="15"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch" />
            <TextBlock
                Name="FileSize"
                Grid.Row="2"
                Margin="0,4,0,0"
                HorizontalAlignment="Right"
                
                
                Text="File size 3233.5 KB"
                IsVisible="False" />
        </Grid>
    </StackPanel>

</UserControl>
