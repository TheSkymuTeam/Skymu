<UserControl
    x:Class="Skymu.Forms.Pages.ErrorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:preferences="clr-namespace:Skymu.Preferences"
    Width="400"
    Height="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Foreground="{DynamicResource Text.HighContrast}"
            TextWrapping="Wrap">
            <TextBlock.Text>
                <Binding
                    Path="[BrandingName]"
                    Source="{x:Static preferences:Settings.Default}"
                    StringFormat="{}Oh no! {0} encountered an unexpected error. Details are provided below. Please report this to the developers so it can be investigated and resolved." />
            </TextBlock.Text>
        </TextBlock>
        <ScrollViewer
            Grid.Row="1"
            Margin="0,20"
            Background="#0A0A0A"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <TextBox
                x:Name="DetailsBox"
                Padding="5"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#888888"
                IsReadOnly="True"
                Text="Error details go here"
                TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</UserControl>
