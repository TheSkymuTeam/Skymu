<Page
    x:Class="Skymu.Forms.Pages.AccountManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Accounts"
    Width="500"
    Height="275"
    Background="Transparent"
    Loaded="Page_Loaded"
    Style="{StaticResource Page}">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  description  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontFamily="Tahoma"
            FontSize="11"
            Foreground="{DynamicResource Text.VeryHighContrast}"
            Text="Select a saved account to log in, enable or disable auto-login for it, adjust its login priority, or remove it. Auto-login uses the highest priority eligible account."
            TextWrapping="Wrap" />

        <!--  account list  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Column="0"
                    Background="{DynamicResource Card.Background}"
                    BorderBrush="{DynamicResource Card.Border}"
                    BorderThickness="1">
                    <Grid>
                        <ListBox
                            x:Name="AccountList"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="AccountList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  avatar (grey box shows through when there is no avatar)  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,8,0"
                                            Background="#FFC8C8C8"
                                            BorderBrush="{DynamicResource Card.Border}"
                                            BorderThickness="1">
                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontFamily="Tahoma"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Text.HighContrast}"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="Tahoma"
                                                FontSize="11"
                                                Foreground="{DynamicResource Text.HighContrast}"
                                                Opacity="0.75"
                                                Text="{Binding Details}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Tahoma"
                                            FontSize="11"
                                            Foreground="{DynamicResource Text.HighContrast}"
                                            Opacity="0.75"
                                            Text="{Binding AutoLoginText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  shown when there are no saved accounts  -->
                        <TextBlock
                            x:Name="EmptyText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Tahoma"
                            FontSize="11"
                            Foreground="{DynamicResource Text.VeryHighContrast}"
                            IsHitTestVisible="False"
                            Opacity="0.75"
                            Text="No saved accounts."
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
                <!--  actions  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="AddAccountButton"
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Click="AddAccountButton_Click"
                        Content="New account"
                        FontFamily="Tahoma"
                        FontSize="11" />
                    <Button
                        x:Name="LoginButton"
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Click="LoginButton_Click"
                        Content="Log in"
                        FontFamily="Tahoma"
                        FontSize="11"
                        IsEnabled="False" />
                    <Button
                        x:Name="AutoLoginButton"
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        VerticalAlignment="Top"
                        Click="AutoLoginButton_Click"
                        Content="Disable auto-login"
                        FontFamily="Tahoma"
                        FontSize="11"
                        IsEnabled="False" />
                    <Button
                        x:Name="RemoveButton"
                        Height="23"
                        MinWidth="73"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Click="RemoveButton_Click"
                        Content="Remove"
                        FontFamily="Tahoma"
                        FontSize="11"
                        IsEnabled="False" />
                    <Button
                        x:Name="RemoveAllButton"
                        Height="23"
                        MinWidth="73"
                        Padding="12,0"
                        Click="RemoveAllButton_Click"
                        Content="Remove all"
                        FontFamily="Tahoma"
                        FontSize="11" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
                <Button
                    x:Name="MoveUpButton"
                    Width="23"
                    Height="23"
                    Margin="0,0,0,4"
                    Click="MoveUpButton_Click"
                    Content="▲"
                    FontSize="9"
                    IsEnabled="False"
                    ToolTip="Move up (tried first for auto-login)" />
                <Button
                    x:Name="MoveDownButton"
                    Width="23"
                    Height="23"
                    Click="MoveDownButton_Click"
                    Content="▼"
                    FontSize="9"
                    IsEnabled="False"
                    ToolTip="Move down (tried later for auto-login)" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
