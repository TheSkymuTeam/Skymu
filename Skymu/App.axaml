<Application
x:Class="Skymu.Universal"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:Skymu"
xmlns:media="using:Avalonia.Media"
xmlns:preferences="clr-namespace:Skymu.Preferences">
	<Application.Styles>
		<Style Selector="Window">
			<Setter Property="UseLayoutRounding" Value="True" />
			<Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
						<Setter Property="FontFamily" Value="Tahoma" />
			<Setter Property="FontSize" Value="11" />
		</Style>
		<Style Selector="UserControl">
			<Setter Property="UseLayoutRounding" Value="True" />
			<Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
			<Setter Property="FontFamily" Value="Tahoma" />
			<Setter Property="FontSize" Value="11" />
		</Style>
		<!--  This fixes the red hyperlink hover color  -->
		<Style Selector="HyperlinkButton">
			<Setter Property="Foreground" Value="{DynamicResource Text.Hyperlink}" />
		</Style>
		<Style Selector="HyperlinkButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Foreground" Value="{DynamicResource Accent}" />
		</Style>
		<Style Selector="ContextMenu">
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0" />
		</Style>
		<Style Selector="Image">
			<Setter Property="UseLayoutRounding" Value="True" />
		</Style>
	</Application.Styles>
	<Application.Resources>
		<ResourceDictionary>
			<media:TextRenderingMode x:Key="AppTextRenderingMode">SubpixelAntialias</media:TextRenderingMode>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Skymu/UIComponents/MessageContextMenu.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<local:LanguageManager x:Key="Lang" />
		</ResourceDictionary>
	</Application.Resources>
</Application>