<Application
x:Class="Skymu.Universal"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:Skymu"
xmlns:preferences="clr-namespace:Skymu.Preferences">
	<Application.Styles>
		<Style Selector="Window">
			<Setter Property="UseLayoutRounding" Value="True" />
			<Setter Property="TextOptions.TextRenderingMode" Value="{DynamicResource AppTextRenderingMode}" />
			<Setter Property="TextOptions.BaselinePixelAlignment" Value="Aligned" />
			<Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
		</Style>
		<Style Selector="Page">
			<Setter Property="UseLayoutRounding" Value="True" />
			<Setter Property="TextOptions.TextRenderingMode" Value="{DynamicResource AppTextRenderingMode}" />
			<Setter Property="TextOptions.BaselinePixelAlignment" Value="Aligned" />
			<Setter Property="Foreground" Value="{DynamicResource Text.VeryHighContrast}" />
		</Style>
	</Application.Styles>
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Skymu/UIComponents/MessageContextMenu.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<local:LanguageManager x:Key="Lang" />
			<Style TargetType="Hyperlink">
				<!--  This fixes the red hyperlink hover color  -->
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Foreground" Value="{DynamicResource Accent}" />
					</Trigger>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="TextDecorations" Value="Underline" />
					</Trigger>
				</Style.Triggers>
				<Setter Property="Foreground" Value="{DynamicResource Text.Hyperlink}" />
				<Setter Property="TextDecorations" Value="{x:Null}" />
			</Style>
			<Style TargetType="{x:Type ContextMenu}">
				<Setter Property="Padding" Value="0" />
				<Setter Property="Margin" Value="0" />
			</Style>
			<Style TargetType="Image">
				<Setter Property="UseLayoutRounding" Value="True" />
				<Setter Property="SnapsToDevicePixels" Value="True" />
				<Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
			</Style>
			<Style TargetType="ListBox">
				<Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
				<Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
				<Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
			</Style>
			<Style TargetType="ListView">
				<Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
				<Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
				<Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
			</Style>
		</ResourceDictionary>
	</Application.Resources>
</Application>