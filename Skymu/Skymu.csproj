<Project Sdk="Microsoft.NET.Sdk">

	<!-- Main thingy -->
	<PropertyGroup>
		<Configurations>Debug;Release;Publish</Configurations>
		<RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
		<SelfContained>false</SelfContained>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net6.0</TargetFramework>
		<ApplicationManifest Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
		<ApplicationIcon Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">Icons\skype.ico</ApplicationIcon>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ApplicationVersion>1.0.0.*</ApplicationVersion>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<NoWarn>$(NoWarn);NETSDK1138;MVVMTKCFG0001</NoWarn>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Output locations (order matters: later lines override earlier ones) -->
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<OutputPath Condition="'$(Configuration)' == 'Publish'">bin\_publishtmp\outer\</OutputPath>
		<OutputPath Condition="'$(InnerFolder)' != ''">bin\_publishtmp\$(InnerFolder)\</OutputPath>
		<IntermediateOutputPath Condition="'$(InnerFolder)' != ''">obj\$(Configuration)\$(InnerFolder)\</IntermediateOutputPath>
	</PropertyGroup>

	<!-- Assembly information -->
	<PropertyGroup>
		<AssemblyTitle>Skymu</AssemblyTitle>
		<Description>Skymu desktop client</Description>
		<FileDescription>Skymu</FileDescription>
		<Company>The Skymu Team</Company>
		<Product>Skymu</Product>
	</PropertyGroup>

	<!-- Build configurations -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Publish'">
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<!-- Some functions to deal with this building hell -->
	<Target Name="CopyPlugins" AfterTargets="Build">
		<ItemGroup>
			<PluginFiles Include="..\Plugins\bin\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(OutDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

	<!-- Publish -->
	<Target Name="PublishAllPlatforms" AfterTargets="Build" Condition="'$(Configuration)' == 'Publish' And '$(InnerPublish)' != 'true'">

		<!-- Windows -->
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="InnerPublish=true;&#xD;&#xA;		                     InnerFolder=windows;&#xD;&#xA;		                     SelfContained=false;&#xD;&#xA;		                     PublishDir=$(MSBuildProjectDirectory)\bin\$(Configuration)\windows\" />

		<!-- macOS + Linux -->
		<ItemGroup>
			<UnixTarget Include="osx-arm64">
				<Folder>macos-arm64</Folder>
			</UnixTarget>
			<UnixTarget Include="osx-x64">
				<Folder>macos-x64</Folder>
			</UnixTarget>
			<UnixTarget Include="linux-x64">
				<Folder>linux-x64</Folder>
			</UnixTarget>
			<UnixTarget Include="linux-arm64">
				<Folder>linux-arm64</Folder>
			</UnixTarget>
		</ItemGroup>

		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="InnerPublish=true;&#xD;&#xA;		                     InnerFolder=%(UnixTarget.Folder);&#xD;&#xA;		                     RuntimeIdentifier=%(UnixTarget.Identity);&#xD;&#xA;		                     SelfContained=true;&#xD;&#xA;		                     PublishSingleFile=true;&#xD;&#xA;		                     PublishDir=$(MSBuildProjectDirectory)\bin\$(Configuration)\%(UnixTarget.Folder)\" />
	</Target>

	<!-- Copy plugins into each published folder -->
	<Target Name="CopyPluginsToPublish" AfterTargets="Publish" Condition="'$(InnerPublish)' == 'true'">
		<ItemGroup>
			<PublishPluginFiles Include="..\Plugins\bin\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(PublishPluginFiles)" DestinationFiles="@(PublishPluginFiles->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

	<!-- Resource Handling -->
	<ItemGroup>
		<!-- Theme assets (embedded for avares:// URIs in XAML) -->
		<AvaloniaResource Include="Themes\Skype4\Assets\**\*" Link="Themes\Skype4\Assets\%(RecursiveDir)%(Filename)%(Extension)" />
		<AvaloniaResource Include="Themes\Skype5\Assets\**\*" Link="Themes\Skype5\Assets\%(RecursiveDir)%(Filename)%(Extension)" />
		<AvaloniaResource Include="Themes\Skype6\Assets\**\*" Link="Themes\Skype6\Assets\%(RecursiveDir)%(Filename)%(Extension)" />
		<AvaloniaResource Include="Themes\Skype7\Assets\**\*" Link="Themes\Skype7\Assets\%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Emoji -->
		<None Remove="Emoji\**\*" />
		<AvaloniaResource Include="Emoji\**\*" />

		<!-- Sounds -->
		<None Remove="Sounds*\**\*" />
		<AvaloniaResource Include="Sounds*\**\*" />

		<!-- Languages as Content -->
		<None Remove="Languages\**\*" />
		<Page Remove="Languages\**\*" />
		<EmbeddedResource Remove="Languages\**\*" />
		<Compile Remove="Languages\**\*" />
		<Content Include="Languages\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>
	<ItemGroup>
		<Resource Remove="Properties\**" />
	</ItemGroup>

	<!-- Packages -->
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.23" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
		<PackageReference Include="Avalonia.Diagnostics" Version="11.3.23" />
		<PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.23" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
		<PackageReference Include="Avalonia.Themes.Simple" Version="11.3.23" />
		<PackageReference Include="Classic.Avalonia.Theme" Version="11.3.0.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Devlooped.CredentialManager" Version="2.7.0" />
		<PackageReference Include="Lib.Harmony" Version="2.4.3" />
		<PackageReference Include="Markdig" Version="1.3.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
		<PackageReference Include="NAudio.Core" Version="2.3.0" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
		<PackageReference Include="System.Text.Json" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Yggdrasil\Yggdrasil.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Colorways\**\*.axaml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Remove="Shaders\Darken.ps" />
		<None Remove="Shaders\DarkenLighten.ps" />
		<AvaloniaResource Include="Shaders\Darken.ps" />
		<AvaloniaResource Include="Shaders\DarkenLighten.ps" />
	</ItemGroup>

</Project>